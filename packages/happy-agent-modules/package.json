{
    "name": "@slopus/happy-agent-modules",
    "version": "0.0.0",
    "description": "Ready-made modules for Happy agents.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/slopus/happy-agent.git",
        "directory": "packages/happy-agent-modules"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./transport": {
            "types": "./dist/transport/index.d.ts",
            "import": "./dist/transport/index.js",
            "default": "./dist/transport/index.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "node --eval \"import('node:fs/promises').then(({ rm }) => rm('dist', { force: true, recursive: true }))\" && tsc -p tsconfig.build.json && node --eval \"import('node:fs/promises').then(({ cp }) => cp('sources/auto/prompts', 'dist/auto/prompts', { recursive: true }))\" && pnpm build:menu-bar",
        "build:menu-bar": "node scripts/build-menu-bar.mjs",
        "check": "tsc --noEmit",
        "test": "vitest run --passWithNoTests",
        "test:live:workos-staging": "vitest run --config vitest.live.config.ts tests/cloud/CloudStaging.live.test.ts"
    },
    "dependencies": {
        "@ff-labs/fff-node": "^0.9.6",
        "@libsql/client": "^0.17.4",
        "@lydell/node-pty": "1.2.0-beta.15",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "@noble/ciphers": "^1.3.0",
        "@noble/curves": "^1.9.7",
        "@noble/hashes": "^1.8.0",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
        "@opentelemetry/resources": "^2.10.0",
        "@opentelemetry/sdk-trace-base": "^2.10.0",
        "@opentelemetry/sdk-trace-node": "^2.10.0",
        "@opentelemetry/semantic-conventions": "^1.43.0",
        "@paralleldrive/cuid2": "^3.3.0",
        "@pydantic/monty": "0.0.21",
        "@sinclair/typebox": "^0.34.49",
        "@slopus/ghostty-wasm": "1.3.6",
        "@slopus/ghostty-web": "0.1.3",
        "@slopus/happy-agent-client": "0.0.49",
        "@slopus/happy-agent-compute": "npm:@slopus/happy-agent-compute@0.1.9",
        "@slopus/happy-providers": "0.0.20",
        "@slopus/murmur": "0.8.1",
        "@steve.kite/stdlib": "0.0.12",
        "@workos-inc/node": "^10.10.0",
        "drizzle-orm": "^0.45.2",
        "jose": "^6.2.10",
        "pino": "^10.3.1",
        "sharp": "^0.35.3",
        "smol-toml": "^1.7.0",
        "socket.io-client": "^4.8.3",
        "turndown": "^7.2.4",
        "ws": "^8.21.1"
    },
    "devDependencies": {
        "@slopus/happy-agent-base": "npm:@slopus/happy-agent-base@0.0.43",
        "@types/node": "^24.0.10",
        "@types/turndown": "^5.0.5",
        "@types/ws": "^8.18.1",
        "typescript": "^7.0.2",
        "vitest": "^3.2.4"
    },
    "peerDependencies": {
        "@slopus/happy-agent-base": "0.0.43"
    },
    "engines": {
        "node": ">=22.19.0"
    }
}
