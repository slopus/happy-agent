{
    "name": "@slopus/happy-providers",
    "version": "0.0.14",
    "description": "Stateful Node.js sessions for Codex, Claude, Grok, Bedrock, and Responses-compatible model providers.",
    "keywords": [
        "ai",
        "anthropic",
        "codex",
        "grok",
        "openai",
        "provider",
        "session"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/slopus/happy-agent.git",
        "directory": "packages/happy-providers"
    },
    "files": [
        "dist",
        "EXAMPLES.md",
        "LICENSE",
        "README.md",
        "VENDOR_*.md"
    ],
    "type": "module",
    "browser": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "node --eval \"import('node:fs/promises').then(({ rm }) => rm('dist', { force: true, recursive: true }))\" && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "check": "tsc --noEmit",
        "prepack": "pnpm run build",
        "test": "vitest run --passWithNoTests && pnpm run test:bun",
        "test:bun": "bun tests/bun/grokOpenAIClient.bun.mjs && bun tests/bun/grokXSearch.bun.mjs"
    },
    "dependencies": {
        "@anthropic-ai/bedrock-sdk": "0.32.0",
        "@anthropic-ai/claude-agent-sdk": "^0.3.226",
        "@anthropic-ai/sdk": "0.110.0",
        "@aws-sdk/credential-provider-node": "3.972.71",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "@sinclair/typebox": "^0.34.49",
        "@smithy/hash-node": "^4.5.2",
        "@smithy/signature-v4": "5.6.9",
        "@steve.kite/stdlib": "0.0.12",
        "deunicode": "1.0.7",
        "openai": "6.46.0",
        "undici": "^8.8.0",
        "wink-porter2-stemmer": "2.0.1"
    },
    "devDependencies": {
        "@types/node": "^24.0.10",
        "@types/ws": "8.18.1",
        "tsc-alias": "^1.8.16",
        "typescript": "^7.0.2",
        "vitest": "^3.2.4"
    },
    "optionalDependencies": {
        "@anthropic-ai/claude-agent-sdk-darwin-arm64": "^0.3.226",
        "@anthropic-ai/claude-agent-sdk-darwin-x64": "^0.3.226",
        "@anthropic-ai/claude-agent-sdk-linux-arm64": "^0.3.226",
        "@anthropic-ai/claude-agent-sdk-linux-arm64-musl": "^0.3.226",
        "@anthropic-ai/claude-agent-sdk-linux-x64": "^0.3.226",
        "@anthropic-ai/claude-agent-sdk-linux-x64-musl": "^0.3.226",
        "@anthropic-ai/claude-agent-sdk-win32-arm64": "^0.3.226",
        "@anthropic-ai/claude-agent-sdk-win32-x64": "^0.3.226"
    },
    "engines": {
        "bun": ">=1.4.0",
        "node": ">=22.19.0"
    }
}
