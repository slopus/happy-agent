+#[tokio::test]
+async fn output_forwarder_propagates_write_failures() -> anyhow::Result<()> {
+    struct BrokenWriter;
+    impl std::io::Write for BrokenWriter {
+        fn write(&mut self, _bytes: &[u8]) -> std::io::Result<usize> {
+            Err(std::io::Error::new(
+                std::io::ErrorKind::BrokenPipe,
+                "closed output",
+            ))
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+    let (tx, rx) = tokio::sync::mpsc::channel(1);
+    let (thread, done) =
+        spawn_output_forwarder(tokio::runtime::Handle::current(), rx, BrokenWriter);
+    tx.send(b"must not disappear".to_vec()).await?;
+    drop(tx);
+    let error = done
+        .await?
+        .expect_err("a failed write must fail the transfer");
+    assert_eq!(error.kind(), std::io::ErrorKind::BrokenPipe);
+    thread.join().expect("join output forwarder");
+    Ok(())
+}
