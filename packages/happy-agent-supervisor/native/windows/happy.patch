+/// Which pair of sandbox accounts runs a command.
+///
+/// Deny-read ACEs attach to the token's ordinary group SIDs, so every command run by one group
+/// shares one persistent deny set. A workspace inside the user profile must be able to read the
+/// profile around it, while a workspace outside it must not read the profile at all. With one
+/// group, alternating between the two rewrote the inheritable deny on the whole profile tree each
+/// time. The external accounts carry that profile deny on their own group instead, so each
+/// group's deny set stays stable and is written once.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "kebab-case")]
+pub enum SandboxScope {
+    #[default]
+    Profile,
+    External,
+}
+
+impl SandboxScope {
+    /// External exactly when the command must not read the user profile: one of its deny-read
+    /// paths is the profile itself or contains it.
+    pub fn for_deny_read_paths(deny_read_paths: &[PathBuf]) -> Self {
+        let Ok(profile) = crate::happy_setup_gate::windows_profile_directory() else {
+            return Self::Profile;
+        };
+        if deny_read_paths
+            .iter()
+            .any(|path| path_contains(path, &profile))
+        {
+            Self::External
+        } else {
+            Self::Profile
+        }
+    }
+
+    pub fn usernames(self) -> (&'static str, &'static str) {
+        match self {
+            Self::Profile => (OFFLINE_USERNAME, ONLINE_USERNAME),
+            Self::External => (OFFLINE_EXTERNAL_USERNAME, ONLINE_EXTERNAL_USERNAME),
+        }
+    }
+
+    pub(crate) const ALL: [Self; 2] = [Self::Profile, Self::External];
+
+    /// Whether a setup record of this version serves the scope. The profile accounts are
+    /// unchanged since version 9; the external accounts exist only from version 10.
+    pub(crate) fn supports_version(self, version: u32) -> bool {
+        match self {
+            Self::Profile => (PROFILE_MIN_SETUP_VERSION..=SETUP_VERSION).contains(&version),
+            Self::External => version == SETUP_VERSION,
+        }
+    }
+
+    /// Every account that must exist and be enabled for the scope to work. The external accounts
+    /// are also members of the shared group, so an external command needs all four.
+    pub(crate) fn required_usernames(self) -> &'static [&'static str] {
+        match self {
+            Self::Profile => &SANDBOX_USERNAMES[..2],
+            Self::External => &SANDBOX_USERNAMES,
+        }
+    }
+}
+
+fn path_contains(root: &Path, path: &Path) -> bool {
+    let root = canonical_path_key(root);
+    let path = canonical_path_key(path);
+    path == root
+        || path
+            .strip_prefix(root.trim_end_matches('/'))
+            .is_some_and(|rest| rest.starts_with('/'))
+}
