+fn derived_cap_sid(seed: &str, purpose: &str, key: &str) -> String {
+    let mut digest = Sha256::new();
+    digest.update(b"happy-windows-cap-v1\0");
+    digest.update(seed.as_bytes());
+    digest.update([0]);
+    digest.update(purpose.as_bytes());
+    digest.update([0]);
+    digest.update(key.as_bytes());
+    let hash = digest.finalize();
+    let number = |index: usize| {
+        u32::from_le_bytes(
+            hash[index..index + 4]
+                .try_into()
+                .expect("four digest bytes"),
+        )
+    };
+    format!(
+        "S-1-5-21-{}-{}-{}-{}",
+        number(0),
+        number(4),
+        number(8),
+        number(12)
