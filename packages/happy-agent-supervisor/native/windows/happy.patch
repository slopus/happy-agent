+/// Explicit user-requested setup, including a deliberate retry after cancellation/failure.
+/// It provisions every scope's accounts, so it is not tied to either scope.
+pub fn run_happy_explicit_setup(request: SandboxSetupRequest<'_>, retry: bool) -> Result<()> {
+    run_elevated_setup_inner(
+        request,
+        None,
+        Some(if retry { SetupIntent::Retry } else { SetupIntent::Explicit }),
+        SandboxScope::Profile,
+    )
+}
