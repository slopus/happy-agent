+pub const OFFLINE_EXTERNAL_USERNAME: &str = "HappySandboxOfflineX";
+pub const ONLINE_EXTERNAL_USERNAME: &str = "HappySandboxOnlineX";
+pub(crate) const SANDBOX_USERNAMES: [&str; 4] = [
+    OFFLINE_USERNAME,
+    ONLINE_USERNAME,
+    OFFLINE_EXTERNAL_USERNAME,
+    ONLINE_EXTERNAL_USERNAME,
+];
