+/// One logged-on runner that serves many commands, one at a time (Happy).
+///
+/// The setup refresh, the logon, and the private desktop happen once here instead of once per
+/// command. Send each command as a `SpawnRequest` cloned from `template` with its own `command`
+/// and `timeout_ms`, then read frames until its `Exit` or `Error`. Call
+/// `deny_read.ensure_current()` before sending each one. Dropping the pipes ends the runner and
+/// every command it is still running.
+pub struct WindowsSandboxServedRunner {
+    pub pipe_write: std::fs::File,
+    pub pipe_read: std::fs::File,
+    pub template: SpawnRequest,
+    pub deny_read: ServedRunnerDenyRead,
+}
+
+/// Keeps a served runner's deny-read ACLs in force between its commands (Happy).
+///
+/// Deny-read ACEs belong to the sandbox group, not to one runner, and every setup reconciles the
+/// group's persisted set to its own request: it applies its paths and revokes the rest. A one-shot
+/// command runs that reconciliation right before it starts. A served runner runs it once, so
+/// another workspace's setup can revoke a deny this runner's commands rely on, such as the user
+/// profile denied to a workspace outside it, and the runner would go on without it. Before each
+/// command, `ensure_current` compares the persisted state with what this runner last left there
+/// and repeats the runner's own setup refresh when it changed. That restores the guarantee a
+/// one-shot command has: its deny set was in force when it started.
+pub struct ServedRunnerDenyRead {
+    fingerprint: Box<dyn Fn() -> Option<Vec<u8>> + Send + Sync>,
+    refresh: Box<dyn Fn() -> Result<()> + Send + Sync>,
+    current: std::sync::Mutex<Option<Vec<u8>>>,
+}
+
+impl ServedRunnerDenyRead {
+    /// Starts from the state the runner's own setup refresh just left.
+    pub(crate) fn new(
+        fingerprint: Box<dyn Fn() -> Option<Vec<u8>> + Send + Sync>,
+        refresh: Box<dyn Fn() -> Result<()> + Send + Sync>,
+    ) -> Self {
+        let current = std::sync::Mutex::new(fingerprint());
+        Self {
+            fingerprint,
+            refresh,
+            current,
+        }
+    }
+
+    /// Re-applies this runner's deny set if another setup changed the persisted one since this
+    /// runner last applied it, and returns whether it had to. After an error the next call tries
+    /// again, and the caller must not start the command.
+    pub fn ensure_current(&self) -> Result<bool> {
+        let mut current = self
+            .current
+            .lock()
+            .map_err(|_| anyhow::anyhow!("deny-read state lock poisoned"))?;
+        if (self.fingerprint)() == *current {
+            return Ok(false);
+        }
+        (self.refresh)()?;
+        *current = (self.fingerprint)();
+        Ok(true)
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(crate) async fn spawn_windows_sandbox_served_runner(
+    permission_profile: &PermissionProfile,
+    workspace_roots: &[AbsolutePathBuf],
+    codex_home: &Path,
+    command: Vec<String>,
+    cwd: &Path,
+    mut env_map: HashMap<String, String>,
+    read_roots_override: Option<&[PathBuf]>,
+    read_roots_include_platform_defaults: bool,
+    write_roots_override: Option<&[PathBuf]>,
+    deny_read_paths_override: &[AbsolutePathBuf],
+    deny_write_paths_override: &[AbsolutePathBuf],
+    use_private_desktop: bool,
+) -> Result<WindowsSandboxServedRunner> {
+    let deny_read_paths_override = deny_read_paths_override
+        .iter()
+        .map(AbsolutePathBuf::to_path_buf)
+        .collect::<Vec<_>>();
+    let deny_write_paths_override = deny_write_paths_override
+        .iter()
+        .map(AbsolutePathBuf::to_path_buf)
+        .collect::<Vec<_>>();
+    let permissions =
+        ResolvedWindowsSandboxPermissions::try_from_permission_profile_for_workspace_roots(
+            permission_profile,
+            workspace_roots,
+        )?;
+    let proxy_settings_mode = crate::WindowsSandboxProxySettingsMode::Reconcile;
+    let refresh = {
+        let permissions = permissions.clone();
+        let codex_home = codex_home.to_path_buf();
+        let cwd = cwd.to_path_buf();
+        let env_map = env_map.clone();
+        let command = command.clone();
+        let read_roots_override = read_roots_override.map(<[PathBuf]>::to_vec);
+        let write_roots_override = write_roots_override.map(<[PathBuf]>::to_vec);
+        let deny_read_paths_override = deny_read_paths_override.clone();
+        let deny_write_paths_override = deny_write_paths_override.clone();
+        move || -> Result<()> {
+            prepare_elevated_spawn_context_for_permissions(
+                permissions.clone(),
+                &codex_home,
+                &cwd,
+                &mut env_map.clone(),
+                &command,
+                read_roots_override.as_deref(),
+                read_roots_include_platform_defaults,
+                write_roots_override.as_deref(),
+                &deny_read_paths_override,
+                &deny_write_paths_override,
+                /*proxy_enforced*/ false,
+                proxy_settings_mode,
+            )
+            .map(|_| ())
+        }
+    };
+    let elevated = prepare_elevated_spawn_context_for_permissions(
+        permissions.clone(),
+        codex_home,
+        cwd,
+        &mut env_map,
+        &command,
+        read_roots_override,
+        read_roots_include_platform_defaults,
+        write_roots_override,
+        &deny_read_paths_override,
+        &deny_write_paths_override,
+        /*proxy_enforced*/ false,
+        proxy_settings_mode,
+    )?;
+    let template = SpawnRequest {
+        command,
+        cwd: cwd.to_path_buf(),
+        env: env_map.clone(),
+        permission_profile: permission_profile.clone(),
+        workspace_roots: workspace_roots.to_vec(),
+        codex_home: elevated.sandbox_base,
+        real_codex_home: codex_home.to_path_buf(),
+        cap_sids: elevated.cap_sids,
+        network_proxy_restricting_sid: None,
+        timeout_ms: None,
+        tty: false,
+        stdin_open: false,
+        use_private_desktop,
+        private_desktop_name: None,
+    };
+    let request = RunnerTransportRequest {
+        permissions,
+        codex_home: codex_home.to_path_buf(),
+        cwd: cwd.to_path_buf(),
+        env_map,
+        logs_base_dir: elevated.logs_base_dir,
+        spawn_request: template.clone(),
+        read_roots_override: read_roots_override.map(<[PathBuf]>::to_vec),
+        read_roots_include_platform_defaults,
+        write_roots_override: write_roots_override.map(<[PathBuf]>::to_vec),
+        deny_read_paths_override,
+        deny_write_paths_override,
+        proxy_enforced: false,
+        proxy_settings_mode,
+    };
+    let transport =
+        spawn_runner_transport_task(elevated.sandbox_creds, request, /*serve*/ true).await?;
+    let template = SpawnRequest {
+        private_desktop_name: transport.private_desktop_name.clone(),
+        ..template
+    };
+    let (pipe_write, pipe_read) = transport.into_files();
+    let state_home = codex_home.to_path_buf();
+    let deny_read = ServedRunnerDenyRead::new(
+        Box::new(move || crate::deny_read_state::deny_read_state_fingerprint(&state_home)),
+        Box::new(refresh),
+    );
+    Ok(WindowsSandboxServedRunner {
+        pipe_write,
+        pipe_read,
+        template,
+        deny_read,
+    })
+}
