+/// Runs many commands at once over the same pipes until the parent closes them (Happy).
+///
+/// The parent pays for one logon, one private desktop, and one setup refresh, instead of one of
+/// each per command. Every frame names its command, and every command gets its own thread,
+/// restricted token, and job, so a slow or blocked command never holds up another. When the
+/// parent closes the pipes, every command still running is stopped before this process exits.
+fn serve(mut pipe_read: File, pipe_write: Arc<StdMutex<File>>) -> Result<()> {
+    let commands: ServedCommands = Arc::new(StdMutex::new(HashMap::new()));
+    let mut threads: Vec<std::thread::JoinHandle<()>> = Vec::new();
+    loop {
+        let ServedFrame {
+            id,
+            keep_descendants,
+            frame,
+        } = match read_served_frame(&mut pipe_read) {
+            Ok(Some(frame)) => frame,
+            Ok(None) | Err(_) => break,
+        };
+        if frame.version != IPC_PROTOCOL_VERSION {
+            send_served_error(
+                &pipe_write,
+                id,
+                ErrorStage::ReadSpawnRequest,
+                &anyhow::anyhow!("runner: unsupported protocol version {}", frame.version),
+            );
+            continue;
+        }
+        match frame.message {
+            Message::SpawnRequest { payload } => {
+                let (controls, received) = std::sync::mpsc::channel();
+                let job = Arc::new(StdMutex::new(None));
+                {
+                    let mut running = commands
+                        .lock()
+                        .map_err(|_| anyhow::anyhow!("runner command table lock poisoned"))?;
+                    if running.contains_key(&id) {
+                        drop(running);
+                        send_served_error(
+                            &pipe_write,
+                            id,
+                            ErrorStage::ReadSpawnRequest,
+                            &anyhow::anyhow!("runner: command {id} is already running"),
+                        );
+                        continue;
+                    }
+                    running.insert(
+                        id,
+                        ServedCommand {
+                            controls,
+                            job: Arc::clone(&job),
+                        },
+                    );
+                }
+                let writer = Arc::clone(&pipe_write);
+                let commands = Arc::clone(&commands);
+                threads.retain(|thread| !thread.is_finished());
+                threads.push(std::thread::spawn(move || {
+                    run_served_command(id, *payload, keep_descendants, received, job, writer, commands)
+                }));
+            }
+            message @ (Message::Stdin { .. }
+            | Message::CloseStdin { .. }
+            | Message::Resize { .. }
+            | Message::Terminate { .. }) => {
+                let Ok(running) = commands.lock() else {
+                    continue;
+                };
+                // A control frame for a command that already ended has nothing left to act on.
+                let Some(command) = running.get(&id) else {
+                    continue;
+                };
+                // Stop the tree here as well: the command's own thread may be blocked writing
+                // stdin the child never reads.
+                if matches!(message, Message::Terminate { .. })
+                    && let Ok(job) = command.job.lock()
+                    && let Some(job) = job.as_ref()
+                {
+                    let _ = job.terminate();
+                }
+                let _ = command.controls.send(message);
+            }
+            Message::SpawnReady { .. }
+            | Message::Output { .. }
+            | Message::Exit { .. }
+            | Message::Error { .. } => {}
+        }
+    }
+    // The parent is gone. Stop every command, then wait for each to release what it holds.
+    if let Ok(mut running) = commands.lock() {
+        for (_, command) in running.drain() {
+            if let Ok(job) = command.job.lock()
+                && let Some(job) = job.as_ref()
+            {
+                let _ = job.terminate();
+            }
+        }
+    }
+    for thread in threads {
+        let _ = thread.join();
+    }
+    Ok(())
+}
