+// The caller environment is filtered for tool execution and is not an identity authority.
+// Resolve the actual Windows logon account before requesting elevation, with no admin fallback.
+fn current_account_name() -> Result<String> {
+    use windows_sys::Win32::Security::Authentication::Identity::{GetUserNameExW, NameSamCompatible};
+    let mut account = vec![0u16; 512];
+    let mut length = account.len() as u32;
+    if unsafe { GetUserNameExW(NameSamCompatible, account.as_mut_ptr(), &mut length) } == 0 {
+        return Err(std::io::Error::last_os_error()).context("resolve Happy caller account");
+    }
+    String::from_utf16(&account[..length as usize]).context("decode Happy caller account")
 }
 
