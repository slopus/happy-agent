+/// Forward bytes to a child's stdin, closing it if the child stops accepting input.
+///
+/// `WriteFile` can consume only part of a buffer on a pipe, so writing continues until every byte
+/// is forwarded. A failed or stalled write closes our end instead of retrying forever.
+fn write_child_stdin(stdin: &mut Option<HANDLE>, bytes: &[u8], log_dir: Option<&Path>) {
+    let Some(handle) = *stdin else {
+        return;
+    };
+    let mut offset = 0usize;
+    while offset < bytes.len() {
+        let chunk = &bytes[offset..];
+        let mut written = 0u32;
+        let ok = unsafe {
+            windows_sys::Win32::Storage::FileSystem::WriteFile(
+                handle,
+                chunk.as_ptr(),
+                chunk.len().min(u32::MAX as usize) as u32,
+                &mut written,
+                ptr::null_mut(),
+            )
+        };
+        if ok == 0 || written == 0 {
+            log_note(
+                &format!("runner stdin write stopped after {offset} bytes; closing child stdin"),
+                log_dir,
+            );
+            unsafe {
+                CloseHandle(handle);
+            }
+            *stdin = None;
+            return;
+        }
+        offset += written as usize;
+    }
+}
