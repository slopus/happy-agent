@@ -0,0 +1,726 @@
+//! One installation setup attempt, shared by every supervisor process.
+//! A failed or interrupted UAC attempt stays latched until an explicit retry.
+
+use anyhow::{Context, Result, bail};
+use serde::{Deserialize, Serialize};
+use std::fs;
+use std::io::Write;
+use std::path::{Path, PathBuf};
+
+use crate::setup::SandboxScope;
+
+/// The real Windows profile, never an app/project or inherited HOME override.
+pub fn default_state_directory() -> Result<PathBuf> {
+    Ok(windows_profile_directory()?.join(".happy").join("windows-sandbox"))
+}
+
+/// The real Windows profile of the current account.
+pub fn windows_profile_directory() -> Result<PathBuf> {
+    use std::os::windows::ffi::OsStringExt;
+    use windows_sys::Win32::System::Com::CoTaskMemFree;
+    use windows_sys::Win32::UI::Shell::{FOLDERID_Profile, SHGetKnownFolderPath};
+    let mut raw = std::ptr::null_mut();
+    let result = unsafe { SHGetKnownFolderPath(&FOLDERID_Profile, 0, 0, &mut raw) };
+    if result < 0 {
+        bail!("resolve Windows user profile: HRESULT {result:#x}")
+    }
+    let mut length = 0;
+    unsafe {
+        while *raw.add(length) != 0 {
+            length += 1;
+        }
+    }
+    let value = unsafe { std::ffi::OsString::from_wide(std::slice::from_raw_parts(raw, length)) };
+    unsafe { CoTaskMemFree(raw as _) };
+    Ok(PathBuf::from(value))
+}
+
+#[derive(Debug, Serialize, Deserialize)]
+struct Attempt {
+    boot_id: u32,
+    completed_failure: bool,
+}
+
+// This outcome cannot be retried until completion or a different Windows boot is proven.
+#[derive(Debug)]
+pub(crate) struct SetupStillPending;
+impl std::fmt::Display for SetupStillPending {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("The setup helper's completion could not be established")
+    }
+}
+impl std::error::Error for SetupStillPending {}
+
+fn current_boot_id() -> Result<u32> {
+    use windows_sys::Wdk::System::Threading::{
+        NtQueryInformationProcess, ProcessTelemetryIdInformation,
+    };
+    use windows_sys::Win32::System::Threading::GetCurrentProcess;
+    // Microsoft PROCESS_TELEMETRY_ID_INFORMATION: BootId is the per-boot counter,
+    // not the persistent BCD loader GUID. Its fixed header places BootId at byte 60.
+    // https://learn.microsoft.com/windows/win32/devnotes/process_telemetry_id_information_type
+    let mut required = 0;
+    unsafe {
+        NtQueryInformationProcess(
+            GetCurrentProcess(),
+            ProcessTelemetryIdInformation,
+            std::ptr::null_mut(),
+            0,
+            &mut required,
+        );
+    }
+    if !(64..=16 * 1024 * 1024).contains(&required) {
+        bail!("Cannot determine the Windows boot identity header size")
+    }
+    let mut information = vec![0u8; required as usize];
+    let status = unsafe {
+        NtQueryInformationProcess(
+            GetCurrentProcess(),
+            ProcessTelemetryIdInformation,
+            information.as_mut_ptr() as _,
+            required,
+            &mut required,
+        )
+    };
+    if status < 0 {
+        bail!("Cannot establish the Windows boot identity: NTSTATUS {status:#x}")
+    }
+    let header_size = u32::from_le_bytes(information[0..4].try_into().unwrap());
+    if header_size < 64 || required < 64 {
+        bail!("Windows returned an incomplete boot identity header")
+    }
+    Ok(u32::from_le_bytes(information[60..64].try_into().unwrap()))
+}
+
+fn save_attempt(path: &Path, attempt: &Attempt) -> Result<()> {
+    let mut record = tempfile::NamedTempFile::new_in(path.parent().context("setup record parent")?)
+        .context("prepare Happy setup attempt record")?;
+    record.write_all(&serde_json::to_vec(attempt)?)?;
+    record
+        .as_file()
+        .sync_all()
+        .context("flush Happy setup attempt before elevation")?;
+    record
+        .persist(path)
+        .context("atomically persist Happy setup attempt before elevation")?;
+    Ok(())
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum SetupIntent {
+    Automatic,
+    Explicit,
+    Retry,
+    Disabled,
+    /// A launch nobody is waiting on, such as a Git scan. It never opens the administrator prompt.
+    Background,
+}
+
+const PROFILE_LATCH: &str = "setup-attempt.json";
+const EXTERNAL_LATCH: &str = "setup-attempt-external.json";
+
+fn read_latch(path: &Path) -> Result<Option<Attempt>> {
+    match fs::read(path) {
+        Ok(bytes) => Ok(Some(
+            serde_json::from_slice(&bytes).context("read Happy setup attempt outcome")?,
+        )),
+        Err(err) if err.kind() == std::io::ErrorKind::NotFound => Ok(None),
+        Err(err) => Err(err).context("read Happy setup attempt outcome"),
+    }
+}
+
+pub(crate) fn run_setup_attempt(
+    home: &Path,
+    scope: SandboxScope,
+    intent: SetupIntent,
+    ready: impl Fn() -> bool,
+    automatic_allowed: impl Fn() -> Result<bool>,
+    provision: impl FnOnce() -> Result<()>,
+) -> Result<()> {
+    if ready() {
+        return Ok(());
+    }
+    if intent == SetupIntent::Background {
+        match scope {
+            SandboxScope::Profile => bail!(
+                "Happy needs a one-time administrator approval before it can read Git changes here. Run `happy-agent sandbox setup`, or start an agent in this workspace."
+            ),
+            SandboxScope::External => bail!(
+                "Happy needs a one-time administrator approval before it can read Git changes in folders outside your user folder. Run `happy-agent sandbox setup`, or start an agent in this workspace."
+            ),
+        }
+    }
+    if intent == SetupIntent::Automatic && !automatic_allowed()? {
+        bail!(
+            "Happy Windows sandbox accounts already exist, but this installation state is missing or needs repair. No account passwords were changed and no Windows prompt was opened. Reuse the existing HAPPY_WINDOWS_SANDBOX_HOME or run `happy-agent sandbox setup` deliberately."
+        );
+    }
+    if intent == SetupIntent::Disabled {
+        bail!(
+            "Happy Windows sandbox setup is required. Automatic provisioning is disabled for this execution; run `happy-agent sandbox setup` deliberately."
+        );
+    }
+    let _lock = crate::setup_mutex::acquire_sandbox_setup_request_lock()?;
+    // The caller may have decided setup was missing before another process completed it.
+    if ready() {
+        return Ok(());
+    }
+    if intent == SetupIntent::Automatic && !automatic_allowed()? {
+        bail!(
+            "Happy Windows sandbox accounts now exist. Reuse their installation state or run `happy-agent sandbox setup` deliberately; no additional setup was started."
+        );
+    }
+    let boot_id = current_boot_id()?;
+    let directory = home.join(".sandbox");
+    fs::create_dir_all(&directory).context("create Happy setup coordination directory")?;
+    // Outside workspaces have their own latch, so a declined outside prompt never blocks a
+    // profile workspace's repair. Every other attempt is recorded in the main one.
+    let main_path = directory.join(PROFILE_LATCH);
+    let external_path = directory.join(EXTERNAL_LATCH);
+    let attempt = if intent == SetupIntent::Automatic && scope == SandboxScope::External {
+        external_path.clone()
+    } else {
+        main_path.clone()
+    };
+    let main = read_latch(&main_path)?;
+    let external = read_latch(&external_path)?;
+    // Two elevated helpers must never overlap, whichever scope started them.
+    if [&main, &external]
+        .into_iter()
+        .flatten()
+        .any(|previous| !previous.completed_failure && previous.boot_id == boot_id)
+    {
+        bail!(
+            "A previous Happy Windows sandbox setup is pending or was interrupted. Finish its existing Windows prompt, or restart Windows before running `happy-agent sandbox setup --retry`. No additional setup was started."
+        );
+    }
+    match intent {
+        SetupIntent::Automatic => {
+            let own = if scope == SandboxScope::External { &external } else { &main };
+            if own.is_some() {
+                match scope {
+                    SandboxScope::Profile => bail!(
+                        "A previous Happy Windows sandbox setup attempt did not complete. No additional Windows prompt was opened. Run `happy-agent sandbox setup --retry` when ready to try again."
+                    ),
+                    SandboxScope::External => bail!(
+                        "Workspaces outside your user folder need a one-time administrator approval. A previous request did not complete. Run `happy-agent sandbox setup --retry` to ask again."
+                    ),
+                }
+            }
+        }
+        SetupIntent::Explicit => {
+            if main.is_some() || external.is_some() {
+                bail!(
+                    "A previous Happy Windows sandbox setup attempt did not complete. No additional Windows prompt was opened. Run `happy-agent sandbox setup --retry` when ready to try again."
+                );
+            }
+        }
+        SetupIntent::Retry | SetupIntent::Disabled | SetupIntent::Background => {}
+    }
+    let mut record = Attempt {
+        boot_id,
+        completed_failure: false,
+    };
+    save_attempt(&attempt, &record)?;
+    // Keep the durable record on failure or process termination. The OS releases the request mutex.
+    if let Err(error) = provision() {
+        if error.downcast_ref::<SetupStillPending>().is_none() {
+            record.completed_failure = true;
+            save_attempt(&attempt, &record)?;
+        }
+        return Err(error);
+    }
+    if !ready() {
+        record.completed_failure = true;
+        save_attempt(&attempt, &record)?;
+        bail!(
+            "Happy Windows sandbox setup returned without a usable installation. Run `happy-agent sandbox setup --retry` to try again."
+        );
+    }
+    // Any success provisions every account, so no earlier failure still applies.
+    for path in [&main_path, &external_path] {
+        match fs::remove_file(path) {
+            Ok(()) => {}
+            Err(err) if err.kind() == std::io::ErrorKind::NotFound => {}
+            Err(err) => return Err(err).context("complete Happy setup attempt"),
+        }
+    }
+    Ok(())
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::{
+        Arc, Barrier,
+        atomic::{AtomicBool, AtomicUsize, Ordering},
+    };
+
+    // Every attempt that gets past readiness takes the machine-wide setup request mutex without
+    // waiting, so tests running on parallel threads would refuse each other. Each test holds this
+    // for its whole body; a panic in one must not fail the rest.
+    static SETUP_REQUEST_TESTS: std::sync::Mutex<()> = std::sync::Mutex::new(());
+
+    fn serialize_setup_request_tests() -> std::sync::MutexGuard<'static, ()> {
+        SETUP_REQUEST_TESTS.lock().unwrap_or_else(|error| error.into_inner())
+    }
+
+    #[test]
+    fn canceled_attempt_does_not_repeat_until_explicit_retry() -> Result<()> {
+        let _serial = serialize_setup_request_tests();
+        let home = tempfile::tempdir()?;
+        let calls = AtomicUsize::new(0);
+        let ready = AtomicBool::new(false);
+        let error = run_setup_attempt(
+            home.path(),
+            SandboxScope::Profile,
+            SetupIntent::Automatic,
+            || ready.load(Ordering::SeqCst),
+            || Ok(true),
+            || {
+                calls.fetch_add(1, Ordering::SeqCst);
+                bail!("UAC canceled in fake provisioner")
+            },
+        )
+        .unwrap_err();
+        assert!(error.to_string().contains("canceled"));
+        for intent in [SetupIntent::Automatic, SetupIntent::Explicit] {
+            let error = run_setup_attempt(
+                home.path(),
+                SandboxScope::Profile,
+                intent,
+                || false,
+                || Ok(true),
+                || {
+                    calls.fetch_add(1, Ordering::SeqCst);
+                    Ok(())
+                },
+            )
+            .unwrap_err();
+            assert!(error.to_string().contains("--retry"));
+        }
+        assert_eq!(calls.load(Ordering::SeqCst), 1);
+        run_setup_attempt(
+            home.path(),
+            SandboxScope::Profile,
+            SetupIntent::Retry,
+            || ready.load(Ordering::SeqCst),
+            || Ok(true),
+            || {
+                calls.fetch_add(1, Ordering::SeqCst);
+                ready.store(true, Ordering::SeqCst);
+                Ok(())
+            },
+        )?;
+        assert_eq!(calls.load(Ordering::SeqCst), 2);
+        assert!(!home.path().join(".sandbox/setup-attempt.json").exists());
+        Ok(())
+    }
+
+    #[test]
+    fn concurrent_requests_launch_only_one_provisioner() -> Result<()> {
+        let _serial = serialize_setup_request_tests();
+        let home = tempfile::tempdir()?;
+        let path = home.path().to_path_buf();
+        let entered = Arc::new(Barrier::new(2));
+        let release = Arc::new(Barrier::new(2));
+        let ready = Arc::new(AtomicBool::new(false));
+        let first = {
+            let entered = entered.clone();
+            let release = release.clone();
+            let ready = ready.clone();
+            std::thread::spawn(move || {
+                run_setup_attempt(
+                    &path,
+                    SandboxScope::Profile,
+                    SetupIntent::Automatic,
+                    || ready.load(Ordering::SeqCst),
+                    || Ok(true),
+                    || {
+                        entered.wait();
+                        release.wait();
+                        ready.store(true, Ordering::SeqCst);
+                        Ok(())
+                    },
+                )
+            })
+        };
+        entered.wait();
+        let other_home = tempfile::tempdir()?;
+        let error = run_setup_attempt(
+            other_home.path(),
+            SandboxScope::Profile,
+            SetupIntent::Retry,
+            || ready.load(Ordering::SeqCst),
+            || Ok(true),
+            || panic!("duplicate provisioning"),
+        )
+        .unwrap_err();
+        assert!(error.to_string().contains("already in progress"));
+        release.wait();
+        first.join().expect("setup worker")?;
+        run_setup_attempt(
+            home.path(),
+            SandboxScope::Profile,
+            SetupIntent::Automatic,
+            || ready.load(Ordering::SeqCst),
+            || Ok(true),
+            || panic!("already provisioned"),
+        )?;
+        Ok(())
+    }
+
+    #[test]
+    fn interrupted_attempt_stays_latched_and_disabled_never_creates_state() -> Result<()> {
+        let _serial = serialize_setup_request_tests();
+        let home = tempfile::tempdir()?;
+        let absent = home.path().join("absent");
+        assert!(
+            run_setup_attempt(
+                &absent,
+                SandboxScope::Profile,
+                SetupIntent::Disabled,
+                || false,
+                || Ok(true),
+                || panic!("disabled setup")
+            )
+            .is_err()
+        );
+        assert!(!absent.exists());
+        fs::create_dir_all(home.path().join(".sandbox"))?;
+        save_attempt(
+            &home.path().join(".sandbox/setup-attempt.json"),
+            &Attempt {
+                boot_id: current_boot_id()?,
+                completed_failure: false,
+            },
+        )?;
+        assert!(
+            run_setup_attempt(
+                home.path(),
+                SandboxScope::Profile,
+                SetupIntent::Automatic,
+                || false,
+                || Ok(true),
+                || panic!("interrupted setup retried")
+            )
+            .is_err()
+        );
+        assert!(
+            run_setup_attempt(
+                home.path(),
+                SandboxScope::Profile,
+                SetupIntent::Retry,
+                || false,
+                || Ok(true),
+                || panic!("pending setup overlapped")
+            )
+            .unwrap_err()
+            .to_string()
+            .contains("restart Windows")
+        );
+        Ok(())
+    }
+
+    #[test]
+    fn uncertain_helper_completion_cannot_be_retried_in_the_same_boot() -> Result<()> {
+        let _serial = serialize_setup_request_tests();
+        let home = tempfile::tempdir()?;
+        let error = run_setup_attempt(
+            home.path(),
+            SandboxScope::Profile,
+            SetupIntent::Explicit,
+            || false,
+            || Ok(true),
+            || Err(SetupStillPending.into()),
+        )
+        .unwrap_err();
+        assert!(error.downcast_ref::<SetupStillPending>().is_some());
+        assert!(
+            run_setup_attempt(
+                home.path(),
+                SandboxScope::Profile,
+                SetupIntent::Retry,
+                || false,
+                || Ok(true),
+                || panic!("helper with uncertain completion was overlapped"),
+            )
+            .unwrap_err()
+            .to_string()
+            .contains("restart Windows")
+        );
+        // Its authoritative completion can still make the installation usable.
+        run_setup_attempt(
+            home.path(),
+            SandboxScope::Profile,
+            SetupIntent::Automatic,
+            || true,
+            || Ok(true),
+            || panic!("completed setup was repeated"),
+        )?;
+        Ok(())
+    }
+
+    #[test]
+    fn checks_readiness_again_after_claiming_the_lock() -> Result<()> {
+        let _serial = serialize_setup_request_tests();
+        let home = tempfile::tempdir()?;
+        let checks = AtomicUsize::new(0);
+        run_setup_attempt(
+            home.path(),
+            SandboxScope::Profile,
+            SetupIntent::Automatic,
+            || checks.fetch_add(1, Ordering::SeqCst) > 0,
+            || Ok(true),
+            || panic!("stale setup decision"),
+        )?;
+        assert_eq!(checks.load(Ordering::SeqCst), 2);
+        assert!(!home.path().join(".sandbox/setup-attempt.json").exists());
+        Ok(())
+    }
+
+    #[test]
+    fn explicit_retry_of_interrupted_attempt_is_allowed_after_a_new_boot() -> Result<()> {
+        let _serial = serialize_setup_request_tests();
+        let home = tempfile::tempdir()?;
+        fs::create_dir_all(home.path().join(".sandbox"))?;
+        let old_boot = current_boot_id()?.wrapping_sub(1);
+        save_attempt(
+            &home.path().join(".sandbox/setup-attempt.json"),
+            &Attempt {
+                boot_id: old_boot,
+                completed_failure: false,
+            },
+        )?;
+        let ready = AtomicBool::new(false);
+        run_setup_attempt(
+            home.path(),
+            SandboxScope::Profile,
+            SetupIntent::Retry,
+            || ready.load(Ordering::SeqCst),
+            || Ok(true),
