+/// Write one frame of a served command's conversation (Happy).
+fn write_served(writer: &Arc<StdMutex<File>>, id: u64, message: Message) -> Result<()> {
+    let frame = ServedFrame {
+        id,
+        keep_descendants: false,
+        frame: FramedMessage {
+            version: IPC_PROTOCOL_VERSION,
+            message,
+        },
+    };
+    let mut guard = writer
+        .lock()
+        .map_err(|_| anyhow::anyhow!("runner pipe writer lock poisoned"))?;
+    write_served_frame(&mut *guard, &frame)
