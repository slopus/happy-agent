+/// Why a launch may or may not open the administrator prompt, from its own flags and
+/// environment. A background launch must never prompt: a restart would otherwise open a prompt
+/// that nobody asked for.
+fn setup_intent(
+    env_map: &HashMap<String, String>,
+    process_no_provision: bool,
+    explicit_intent: Option<SetupIntent>,
+) -> SetupIntent {
+    let enabled = |name: &str| env_map.get(name).is_some_and(|value| value == "1");
+    if enabled("HAPPY_WINDOWS_SANDBOX_NO_PROVISION") || process_no_provision {
+        return SetupIntent::Disabled;
+    }
+    explicit_intent.unwrap_or_else(|| {
+        if !enabled("HAPPY_WINDOWS_SANDBOX_ALLOW_AUTO_SETUP") {
+            SetupIntent::Disabled
+        } else if enabled("HAPPY_WINDOWS_SANDBOX_BACKGROUND") {
+            SetupIntent::Background
+        } else {
+            SetupIntent::Automatic
+        }
+    })
 }
 
