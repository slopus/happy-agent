+        let empty_state = home.path().join("another-home");
+        let error = run_setup_attempt(
+            &empty_state,
+            SandboxScope::Profile,
+            SetupIntent::Automatic,
+            || false,
+            || Ok(false),
+            || panic!("existing global accounts were reset"),
