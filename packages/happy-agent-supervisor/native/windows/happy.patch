+/// Starts a refresh helper outside the job of the process that asked for it (Happy).
+///
+/// Adding or revoking a deny-read ACE on a large folder such as the user profile rewrites the
+/// inherited ACEs of everything below it, which can take longer than any caller waits. A helper
+/// in the supervisor's kill-on-close job was killed with the supervisor part-way through, and the
+/// next command started the same rewrite again from the beginning, so it never finished. Outside
+/// the job it runs to completion. Only the helper holding the read-ACL lock keeps working; every
+/// other one gives up within the lock wait, so at most one outlives its caller for long.
+fn spawn_outliving_caller(cmd: &mut Command) -> std::io::Result<std::process::Child> {
+    const CREATE_BREAKAWAY_FROM_JOB: u32 = 0x0100_0000;
+    const ERROR_ACCESS_DENIED: i32 = 5;
+    match cmd.creation_flags(CREATE_BREAKAWAY_FROM_JOB).spawn() {
+        // A job that does not permit breakaway refuses the flag; stay in it rather than fail.
+        Err(err) if err.raw_os_error() == Some(ERROR_ACCESS_DENIED) => {
+            cmd.creation_flags(0).spawn()
+        }
+        result => result,
+    }
+}
