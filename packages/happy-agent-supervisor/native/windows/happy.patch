+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn lossless_driver_backpressures_tiny_chunks_and_drains_after_exit() -> anyhow::Result<()> {
+    let (writer_tx, _writer_rx) = tokio::sync::mpsc::channel::<Vec<u8>>(1);
+    let (stdout_tx, stdout_driver_rx) = tokio::sync::mpsc::channel::<Vec<u8>>(8);
+    let (stderr_tx, stderr_driver_rx) = tokio::sync::mpsc::channel::<Vec<u8>>(8);
+    let (exit_tx, exit_rx) = tokio::sync::oneshot::channel::<i32>();
+    let spawned = spawn_from_driver(ProcessDriver {
+        writer_tx,
+        stdout_rx: stdout_driver_rx,
+        stderr_rx: Some(stderr_driver_rx),
+        exit_rx,
+        terminator: None,
+        writer_handle: None,
+        resizer: None,
+        #[cfg(windows)]
+        tty: false,
+    });
+    let SpawnedProcess {
+        session: _session,
+        stdout_rx,
+        stderr_rx,
+        exit_rx,
+    } = spawned;
+    // Exit may arrive before the final stream bytes. Neither exit nor a slow
+    // consumer may turn the bounded output queues into a lossy broadcast.
+    exit_tx.send(7).expect("send early exit");
+    assert_eq!(exit_rx.await?, 7);
+    let mut producer = tokio::spawn(async move {
+        for index in 0..8192_u32 {
+            stdout_tx.send(index.to_le_bytes().to_vec()).await?;
+            stderr_tx
+                .send((u32::MAX - index).to_le_bytes().to_vec())
+                .await?;
+        }
+        Ok::<_, tokio::sync::mpsc::error::SendError<Vec<u8>>>(())
+    });
+    // The queues contain far fewer than 8192 chunks, so completion without
+    // draining would mean data was discarded or buffering became unbounded.
+    assert!(
+        tokio::time::timeout(tokio::time::Duration::from_millis(20), &mut producer)
+            .await
+            .is_err()
+    );
+    let stdout_task = tokio::spawn(async move { collect_split_output(stdout_rx).await });
+    let stderr_task = tokio::spawn(async move { collect_split_output(stderr_rx).await });
+    tokio::time::timeout(tokio::time::Duration::from_secs(5), producer).await???;
+    let stdout = stdout_task.await?;
+    let stderr = stderr_task.await?;
+    let expected_stdout: Vec<u8> = (0..8192_u32).flat_map(u32::to_le_bytes).collect();
+    let expected_stderr: Vec<u8> = (0..8192_u32)
+        .flat_map(|index| (u32::MAX - index).to_le_bytes())
+        .collect();
+    assert_eq!(stdout, expected_stdout);
+    assert_eq!(stderr, expected_stderr);
+    Ok(())
+}
