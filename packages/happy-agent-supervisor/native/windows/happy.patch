+    fn a_refresh_helper_outlives_its_callers_kill_on_close_job() {
+        unsafe {
+            let job = CreateJobObjectW(std::ptr::null(), std::ptr::null());
+            assert_ne!(job, 0);
+            let mut limits: JOBOBJECT_EXTENDED_LIMIT_INFORMATION = std::mem::zeroed();
+            limits.BasicLimitInformation.LimitFlags =
+                JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE | JOB_OBJECT_LIMIT_BREAKAWAY_OK;
+            assert_ne!(
+                SetInformationJobObject(
+                    job,
+                    JobObjectExtendedLimitInformation,
+                    &limits as *const JOBOBJECT_EXTENDED_LIMIT_INFORMATION as *const c_void,
+                    std::mem::size_of::<JOBOBJECT_EXTENDED_LIMIT_INFORMATION>() as u32,
+                ),
+                0
+            );
+            let mut caller = Command::new(std::env::current_exe().unwrap())
+                .args([
+                    "--exact",
+                    "setup::breakaway_tests::outliving_caller_child",
+                    "--ignored",
+                    "--nocapture",
+                    "--test-threads=1",
+                ])
+                .env(CALLER_ENV, "1")
+                .stdin(Stdio::piped())
+                .stdout(Stdio::piped())
+                .stderr(Stdio::null())
+                .spawn()
+                .unwrap();
+            assert_ne!(AssignProcessToJobObject(job, caller.as_raw_handle() as _), 0);
+            caller.stdin.take().unwrap().write_all(b"go\n").unwrap();
+            let helper_pid: u32 = BufReader::new(caller.stdout.take().unwrap())
+                .lines()
+                .map_while(Result::ok)
+                // The harness prints the test's name on the same line, before the output.
+                .find_map(|line| line.split_once("helper=").map(|(_, pid)| pid.trim().parse().unwrap()))
+                .expect("the caller reports its helper");
+
+            // Closing the job's only handle kills the caller, as stopping a supervisor does.
+            CloseHandle(job);
+            caller.wait().unwrap();
+
+            let helper = OpenProcess(
+                PROCESS_QUERY_LIMITED_INFORMATION | PROCESS_SYNCHRONIZE | PROCESS_TERMINATE,
+                0,
+                helper_pid,
