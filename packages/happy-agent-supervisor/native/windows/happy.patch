+/// Fails unless `member` belongs to `group`, read back from the account database.
+fn require_local_group_member(group: &str, member: &str) -> Result<()> {
+    let member_w = to_wide(OsStr::new(member));
+    let mut buffer: *mut u8 = std::ptr::null_mut();
+    let mut read = 0u32;
+    let mut total = 0u32;
+    let status = unsafe {
+        NetUserGetLocalGroups(
+            std::ptr::null(),
+            member_w.as_ptr(),
+            0,
+            LG_INCLUDE_INDIRECT,
+            &mut buffer,
+            MAX_PREFERRED_LENGTH,
+            &mut read,
+            &mut total,
+        )
+    };
+    let mut found = false;
+    if status == NERR_Success && !buffer.is_null() {
+        let entries = unsafe {
+            std::slice::from_raw_parts(buffer as *const LOCALGROUP_USERS_INFO_0, read as usize)
+        };
+        for entry in entries {
+            let name = unsafe {
+                let mut length = 0;
+                while *entry.lgrui0_name.add(length) != 0 {
+                    length += 1;
+                }
+                String::from_utf16_lossy(std::slice::from_raw_parts(entry.lgrui0_name, length))
+            };
+            if name.eq_ignore_ascii_case(group) {
+                found = true;
+            }
+        }
+    }
+    if !buffer.is_null() {
+        unsafe { NetApiBufferFree(buffer as *const c_void) };
+    }
+    if found {
+        return Ok(());
+    }
+    Err(anyhow::Error::new(SetupFailure::new(
+        SetupErrorCode::HelperUserProvisionFailed,
+        format!("sandbox user {member} is not a member of {group} (status {status})"),
+    )))
