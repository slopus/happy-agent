+            assert_ne!(helper, 0, "the helper was killed with its caller's job");
+            let still_running = WaitForSingleObject(helper, 500) == WAIT_TIMEOUT;
+            TerminateProcess(helper, 1);
+            CloseHandle(helper);
+            assert!(still_running, "the helper was killed with its caller's job");
+        }
+    }
