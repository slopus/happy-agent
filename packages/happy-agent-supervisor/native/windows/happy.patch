+    let (_stderr_tx, stderr_rx) = oneshot::channel();
+    let error = wait_for_output_forwarders(stdout_rx, stderr_rx, Duration::from_millis(10))
+        .await
+        .expect_err("incomplete drain must not report success");
+    assert_eq!(error.kind(), std::io::ErrorKind::TimedOut);
+    Ok(())
+}
