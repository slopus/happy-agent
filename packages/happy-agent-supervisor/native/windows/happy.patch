+#[tokio::test]
+async fn output_forwarder_propagates_write_failures() -> anyhow::Result<()> {
+    struct BrokenWriter;
+    impl std::io::Write for BrokenWriter {
+        fn write(&mut self, _bytes: &[u8]) -> std::io::Result<usize> {
+            Err(std::io::Error::new(
+                std::io::ErrorKind::BrokenPipe,
+                "closed output",
+            ))
+        }
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+    let (tx, rx) = tokio::sync::mpsc::channel(1);
+    let (thread, done) =
+        spawn_output_forwarder(tokio::runtime::Handle::current(), rx, BrokenWriter);
+    tx.send(b"must not disappear".to_vec()).await?;
+    drop(tx);
+    let error = done
+        .await?
+        .expect_err("a failed write must fail the transfer");
+    assert_eq!(error.kind(), std::io::ErrorKind::BrokenPipe);
+    thread.join().expect("join output forwarder");
+    Ok(())
+}
+
+#[tokio::test]
+async fn output_drain_propagates_failure_and_timeout() -> anyhow::Result<()> {
+    let (stdout_tx, stdout_rx) = oneshot::channel();
+    let (stderr_tx, stderr_rx) = oneshot::channel();
+    stdout_tx.send(Ok(())).expect("stdout completed");
+    stderr_tx
+        .send(Err(std::io::Error::new(
+            std::io::ErrorKind::BrokenPipe,
+            "stderr closed",
+        )))
+        .expect("stderr failed");
+    let error = wait_for_output_forwarders(stdout_rx, stderr_rx, Duration::from_secs(1))
+        .await
+        .expect_err("stderr failure must propagate");
+    assert_eq!(error.kind(), std::io::ErrorKind::BrokenPipe);
+
+    let (_stdout_tx, stdout_rx) = oneshot::channel();
+    let (_stderr_tx, stderr_rx) = oneshot::channel();
+    let error = wait_for_output_forwarders(stdout_rx, stderr_rx, Duration::from_millis(10))
+        .await
+        .expect_err("incomplete drain must not report success");
+    assert_eq!(error.kind(), std::io::ErrorKind::TimedOut);
+    Ok(())
+}
