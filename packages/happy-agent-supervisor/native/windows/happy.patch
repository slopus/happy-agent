+pub use backends::elevated::ServedRunnerDenyRead;
+pub use backends::elevated::WindowsSandboxServedRunner;
+
+/// Starts one elevated runner that serves many pipe commands without a terminal (Happy).
+pub async fn spawn_windows_sandbox_served_runner(
+    request: WindowsSandboxSessionRequest<'_>,
+) -> Result<WindowsSandboxServedRunner> {
+    if !matches!(request.windows_sandbox_level, WindowsSandboxLevel::Elevated)
+        || request.proxy_enforced
+        || request.network_proxy_restricting_sid.is_some()
+        || request.tty
+        || request.stdin_open
+    {
+        bail!("a served runner requires the elevated backend without proxying, a terminal, or input");
+    }
+    backends::elevated::spawn_windows_sandbox_served_runner(
+        request.permission_profile,
+        request.workspace_roots,
+        request.codex_home,
+        request.command,
+        request.cwd,
+        request.env_map,
+        request.read_roots_override,
+        request.read_roots_include_platform_defaults,
+        request.write_roots_override,
+        request.deny_read_paths_override,
+        request.deny_write_paths_override,
+        request.use_private_desktop,
+    )
+    .await
+}
