+// 9 replaces the account-wide bind blocks with listen and inbound blocks; 10 adds the accounts
+// for workspaces outside the user profile. A version 9 installation keeps serving the profile
+// accounts as it did; only the outside accounts need version 10.
+pub const SETUP_VERSION: u32 = 10;
+const PROFILE_MIN_SETUP_VERSION: u32 = 9;
+pub const OFFLINE_USERNAME: &str = "HappySandboxOffline";
+pub const ONLINE_USERNAME: &str = "HappySandboxOnline";
