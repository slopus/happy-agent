+    /// Runs one attempt whose provisioner reports `outcome`, returning the error text and the
+    /// number of times it provisioned.
+    fn attempt(
+        home: &Path,
+        scope: SandboxScope,
+        intent: SetupIntent,
+        outcome: Result<(), &str>,
+        ready_after_success: &AtomicBool,
+    ) -> (Result<()>, usize) {
+        let calls = AtomicUsize::new(0);
+        let result = run_setup_attempt(
+            home,
+            scope,
+            intent,
+            || ready_after_success.load(Ordering::SeqCst),
+            || Ok(true),
+            || {
+                calls.fetch_add(1, Ordering::SeqCst);
+                match outcome {
+                    Ok(()) => {
+                        ready_after_success.store(true, Ordering::SeqCst);
+                        Ok(())
+                    }
+                    Err(message) => bail!("{message}"),
