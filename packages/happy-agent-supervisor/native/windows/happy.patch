+    /// The caller in `a_refresh_helper_outlives_its_callers_kill_on_close_job`; it does nothing
+    /// unless that test started it inside its job.
+    #[test]
+    #[ignore]
+    fn outliving_caller_child() {
+        if std::env::var_os(CALLER_ENV).is_none() {
+            return;
+        }
+        let mut line = String::new();
+        std::io::stdin().lock().read_line(&mut line).unwrap();
+        let helper = spawn_outliving_caller(
+            Command::new("ping")
+                .args(["-n", "30", "127.0.0.1"])
+                .stdin(Stdio::null())
+                .stdout(Stdio::null())
+                .stderr(Stdio::null()),
+        )
+        .unwrap();
+        println!("helper={}", helper.id());
+        std::io::stdout().flush().unwrap();
+        std::thread::sleep(std::time::Duration::from_secs(60));
+    }
