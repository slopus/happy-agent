+#[test]
+fn served_runner_reapplies_its_deny_set_only_after_another_setup_changed_it() {
+    use super::ServedRunnerDenyRead;
+    use std::sync::Arc;
+    use std::sync::Mutex;
+    use std::sync::atomic::AtomicUsize;
+    use std::sync::atomic::Ordering;
+
+    // The persisted state as this runner's own setup left it.
+    let state = Arc::new(Mutex::new(Some(b"profile denied".to_vec())));
+    let refreshes = Arc::new(AtomicUsize::new(0));
+    let fail = Arc::new(Mutex::new(false));
+    let deny_read = {
+        let state = Arc::clone(&state);
+        let refresh_state = Arc::clone(&state);
+        let refreshes = Arc::clone(&refreshes);
+        let fail = Arc::clone(&fail);
+        ServedRunnerDenyRead::new(
+            Box::new(move || state.lock().unwrap().clone()),
+            Box::new(move || {
+                if *fail.lock().unwrap() {
+                    anyhow::bail!("setup refresh failed");
+                }
+                refreshes.fetch_add(1, Ordering::SeqCst);
+                *refresh_state.lock().unwrap() = Some(b"profile denied".to_vec());
+                Ok(())
+            }),
+        )
+    };
+
+    // Nothing changed: commands start without another setup refresh.
+    assert_eq!(false, deny_read.ensure_current().unwrap());
+    assert_eq!(false, deny_read.ensure_current().unwrap());
+    assert_eq!(0, refreshes.load(Ordering::SeqCst));
+
+    // Another workspace's setup revoked the profile deny.
+    *state.lock().unwrap() = Some(b"profile allowed".to_vec());
+    assert_eq!(true, deny_read.ensure_current().unwrap());
+    assert_eq!(1, refreshes.load(Ordering::SeqCst));
+    assert_eq!(false, deny_read.ensure_current().unwrap());
+
+    // A refresh that fails leaves the runner stale, so the command must not start and the next
+    // command tries again.
+    *state.lock().unwrap() = None;
+    *fail.lock().unwrap() = true;
+    assert!(deny_read.ensure_current().is_err());
+    *fail.lock().unwrap() = false;
+    assert_eq!(true, deny_read.ensure_current().unwrap());
+    assert_eq!(2, refreshes.load(Ordering::SeqCst));
+}
