{
    "name": "@slopus/happy-agent",
    "version": "0.0.0",
    "description": "The Happy Agent daemon.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/slopus/happy-agent.git",
        "directory": "packages/happy-agent"
    },
    "bin": {
        "happy-agent": "./dist/cli.js"
    },
    "files": [
        "dist",
        "API.md",
        "README.md"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./cli": {
            "import": "./dist/cli.js",
            "default": "./dist/cli.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "node --eval \"import('node:fs/promises').then(({ rm }) => rm('dist', { force: true, recursive: true }))\" && tsc -p tsconfig.build.json && node scripts/copy-docs.mjs",
        "build:bun": "pnpm dlx bun@1.4.0 scripts/build-binary.ts",
        "build:bun:all": "pnpm dlx bun@1.4.0 scripts/build-binary.ts --all",
        "check": "tsc --noEmit",
        "test": "vitest run --passWithNoTests",
        "test:bun:transports": "pnpm dlx bun@1.4.0 test ./tests/bun/teamTerminalTransport.bun.mjs",
        "build:native:monty": "node scripts/build-native-monty.mjs",
        "test:native:monty": "node scripts/verify-native-monty.mjs",
        "test:native:transport": "bun scripts/verify-windows-sockets.ts",
        "build:native:libsql": "node scripts/build-native-libsql.mjs",
        "test:native:libsql": "node --expose-gc scripts/verify-native-libsql.mjs && bun scripts/verify-native-libsql.mjs",
        "build:native:fff": "node scripts/build-native-fff.mjs",
        "test:native:fff": "node scripts/verify-native-fff.mjs && bun scripts/verify-native-fff.mjs"
    },
    "dependencies": {
        "@sinclair/typebox": "^0.34.49",
        "@slopus/happy-agent-base": "0.0.54",
        "@slopus/happy-agent-client": "0.0.64",
        "@slopus/happy-agent-compute": "0.1.15",
        "@slopus/happy-agent-modules": "workspace:*",
        "@slopus/happy-agent-supervisor": "0.0.9",
        "@slopus/happy-providers": "0.0.27",
        "@steve.kite/stdlib": "0.0.12"
    },
    "devDependencies": {
        "@types/node": "^24.0.10",
        "jose": "^6.2.10",
        "typescript": "^7.0.2",
        "vitest": "^3.2.4"
    },
    "engines": {
        "node": ">=22.19.0"
    }
}
