{
    "name": "@slopus/happy-agent",
    "version": "0.1.0",
    "private": true,
    "description": "Happy Agent Rust provider and durable agent runtime. Product daemon migration is incomplete.",
    "license": "MIT",
    "bin": {
        "happy-agent": "./bin/happy-agent.cjs"
    },
    "files": [
        "bin",
        "RUST.md",
        "README.md",
        "API.md"
    ],
    "type": "module",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "cargo build --locked --package happy-agent",
        "build:native": "node scripts/build-native.mjs",
        "check": "cargo check --locked --package happy-agent --all-targets",
        "test": "cargo test --locked --package happy-agent",
        "package:native": "node scripts/package-native.mjs"
    },
    "engines": {
        "node": ">=22"
    }
}
