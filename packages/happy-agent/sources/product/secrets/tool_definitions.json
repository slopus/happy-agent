[
    {
        "name": "list_secrets",
        "description": "List bounded secret references and environment-variable names. Secret values are never available to the model.",
        "parameters": {
            "additionalProperties": false,
            "type": "object",
            "properties": {
                "cursor": {
                    "minLength": 2,
                    "maxLength": 32,
                    "pattern": "^[a-z][a-z0-9_-]*$",
                    "type": "string"
                },
                "limit": {
                    "minimum": 1,
                    "maximum": 50,
                    "type": "integer"
                }
            }
        },
        "defer": true
    },
    {
        "name": "reference_secret",
        "description": "Read one secret reference, including its description and environment-variable names. The secret value is never returned.",
        "parameters": {
            "additionalProperties": false,
            "type": "object",
            "required": ["id"],
            "properties": {
                "id": {
                    "minLength": 2,
                    "maxLength": 32,
                    "pattern": "^[a-z][a-z0-9_-]*$",
                    "type": "string"
                }
            }
        },
        "defer": true
    },
    {
        "name": "create_secret",
        "description": "Create one global secret from exactly one value source: inline environment arguments or an absolute host .env file. Returns safe metadata only and does not attach the secret to any agent.",
        "parameters": {
            "additionalProperties": false,
            "type": "object",
            "required": ["description"],
            "properties": {
                "id": {
                    "minLength": 2,
                    "maxLength": 32,
                    "pattern": "^[a-z][a-z0-9_-]*$",
                    "type": "string"
                },
                "description": {
                    "minLength": 1,
                    "maxLength": 2000,
                    "type": "string"
                },
                "environment": {
                    "additionalProperties": false,
                    "minProperties": 1,
                    "maxProperties": 256,
                    "type": "object",
                    "patternProperties": {
                        "^[A-Za-z_][A-Za-z0-9_]*$": {
                            "maxLength": 65536,
                            "pattern": "^[^\\u0000]*$",
                            "type": "string"
                        }
                    }
                },
                "dotenvFile": {
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "^[^\\u0000]+$",
                    "description": "Absolute path to a UTF-8 .env file whose complete environment bundle should be stored. The file is read host-side after review; its values are never returned.",
                    "type": "string"
                },
                "availableToAgents": {
                    "description": "Whether agents may attach this reference to commands. Defaults to available.",
                    "type": "boolean"
                }
            }
        },
        "defer": true
    },
    {
        "name": "update_secret",
        "description": "Update a global secret from exactly one replacement source: inline environment arguments or an absolute host .env file. Removed variables do not linger. Safe metadata is returned; attachments are unchanged.",
        "parameters": {
            "additionalProperties": false,
            "type": "object",
            "required": ["secretId"],
            "properties": {
                "secretId": {
                    "minLength": 2,
                    "maxLength": 32,
                    "pattern": "^[a-z][a-z0-9_-]*$",
                    "type": "string"
                },
                "environment": {
                    "additionalProperties": false,
                    "minProperties": 1,
                    "maxProperties": 256,
                    "type": "object",
                    "patternProperties": {
                        "^[A-Za-z_][A-Za-z0-9_]*$": {
                            "maxLength": 65536,
                            "pattern": "^[^\\u0000]*$",
                            "type": "string"
                        }
                    }
                },
                "dotenvFile": {
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "^[^\\u0000]+$",
                    "description": "Absolute path to a UTF-8 .env file whose complete environment bundle should be stored. The file is read host-side after review; its values are never returned.",
                    "type": "string"
                },
                "description": {
                    "minLength": 1,
                    "maxLength": 2000,
                    "type": "string"
                },
                "availableToAgents": {
                    "description": "Whether agents may attach this reference to commands. Omit to preserve its current setting.",
                    "type": "boolean"
                }
            }
        },
        "defer": true
    },
    {
        "name": "attach_secret",
        "description": "Attach a registered secret reference to this exact agent. This changes availability only; it never returns the secret value.",
        "parameters": {
            "additionalProperties": false,
            "type": "object",
            "required": ["secretId"],
            "properties": {
                "secretId": {
                    "minLength": 2,
                    "maxLength": 32,
                    "pattern": "^[a-z][a-z0-9_-]*$",
                    "type": "string"
                }
            }
        },
        "defer": true
    },
    {
        "name": "detach_secret",
        "description": "Detach a secret reference from this exact agent. The result contains only identifiers and never the secret value.",
        "parameters": {
            "additionalProperties": false,
            "type": "object",
            "required": ["secretId"],
            "properties": {
                "secretId": {
                    "minLength": 2,
                    "maxLength": 32,
                    "pattern": "^[a-z][a-z0-9_-]*$",
                    "type": "string"
                }
            }
        },
        "defer": true
    }
]
