[
    {
        "name": "list_mcp_servers",
        "description": "List configured MCP servers and their current connection status. Results are bounded and cursor-paged.",
        "parameters": {
            "additionalProperties": false,
            "type": "object",
            "properties": {
                "cursor": {
                    "minLength": 1,
                    "maxLength": 32,
                    "type": "string"
                },
                "limit": {
                    "minimum": 1,
                    "maximum": 100,
                    "type": "integer"
                }
            }
        },
        "returnType": {
            "additionalProperties": false,
            "type": "object",
            "required": ["servers"],
            "properties": {
                "nextCursor": {
                    "minLength": 1,
                    "maxLength": 32,
                    "type": "string"
                },
                "servers": {
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                        "additionalProperties": false,
                        "type": "object",
                        "required": ["name", "status", "toolCount"],
                        "properties": {
                            "disabledTools": {
                                "maxItems": 100,
                                "uniqueItems": true,
                                "type": "array",
                                "items": {
                                    "minLength": 1,
                                    "maxLength": 128,
                                    "type": "string"
                                }
                            },
                            "enabledTools": {
                                "maxItems": 100,
                                "uniqueItems": true,
                                "type": "array",
                                "items": {
                                    "minLength": 1,
                                    "maxLength": 128,
                                    "type": "string"
                                }
                            },
                            "errorMessage": {
                                "maxLength": 2000,
                                "type": "string"
                            },
                            "fingerprint": {
                                "minLength": 64,
                                "maxLength": 64,
                                "pattern": "^[0-9a-f]{64}$",
                                "type": "string"
                            },
                            "name": {
                                "minLength": 1,
                                "maxLength": 128,
                                "type": "string"
                            },
                            "promptSupport": {
                                "type": "boolean"
                            },
                            "resourceSupport": {
                                "type": "boolean"
                            },
                            "status": {
                                "anyOf": [
                                    {
                                        "const": "blocked",
                                        "type": "string"
                                    },
                                    {
                                        "const": "connected",
                                        "type": "string"
                                    },
                                    {
                                        "const": "disabled",
                                        "type": "string"
                                    },
                                    {
                                        "const": "failed",
                                        "type": "string"
                                    }
                                ]
                            },
                            "toolCount": {
                                "minimum": 0,
                                "maximum": 10000,
                                "type": "integer"
                            }
                        }
                    }
                }
            }
        },
        "defer": true,
        "reloadable": true,
        "durable": false,
        "requiresAutoOrFullAccess": true,
        "capabilities": ["Discover and use configured MCP servers, resources, prompts, and tools."],
        "searchKeywords": ["list MCP servers", "connected external servers", "MCP configuration"],
        "autoPermissionInstructions": null,
        "shouldReview": false,
        "fullAccess": null,
        "describe": null
    },
    {
        "name": "configure_mcp_server",
