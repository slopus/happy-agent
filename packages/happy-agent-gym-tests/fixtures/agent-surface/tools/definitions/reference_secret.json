{
  "capabilities": [
    "List and attach registered secret references without revealing values."
  ],
  "defer": true,
  "description": "Read one secret reference, including its description and environment-variable names. The secret value is never returned.",
  "durable": true,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "id": {
        "maxLength": 32,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9_-]*$",
        "type": "string"
      }
    },
    "required": [
      "id"
    ],
    "type": "object"
  },
  "name": "reference_secret",
  "reloadable": true,
  "returnType": {
    "additionalProperties": false,
    "properties": {
      "secret": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "availableToAgents": {
                "type": "boolean"
              },
              "createdAt": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "description": {
                "maxLength": 2000,
                "minLength": 1,
                "type": "string"
              },
              "environmentVariables": {
                "items": {
                  "maxLength": 256,
                  "minLength": 1,
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                  "type": "string"
                },
                "maxItems": 256,
                "type": "array",
                "uniqueItems": true
              },
              "id": {
                "maxLength": 32,
                "minLength": 2,
                "pattern": "^[a-z][a-z0-9_-]*$",
                "type": "string"
              },
              "managed": {
                "type": "boolean"
              },
              "updatedAt": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "version": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "type": "string"
              }
            },
            "required": [
              "id",
              "description",
              "environmentVariables",
              "managed",
              "availableToAgents",
              "version",
              "createdAt",
              "updatedAt"
            ],
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "secret"
    ],
    "type": "object"
  },
  "searchKeywords": [
    "secret metadata",
    "credential description",
    "environment variables"
  ]
}
