              "additionalProperties": false,
              "properties": {
                "agentId": {
                  "maxLength": 32,
                  "minLength": 2,
                  "pattern": "^[a-z][a-z0-9]*$",
                  "type": "string"
                },
                "name": {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string"
                },
                "userId": {
                  "maxLength": 256,
                  "minLength": 1,
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
                  "type": "string"
                }
              },
              "required": [
                "userId",
                "agentId",
                "name"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "deniedUsers": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "at": {
                  "minimum": 0,
                  "type": "integer"
                },
                "name": {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string"
                },
                "userId": {
                  "maxLength": 256,
                  "minLength": 1,
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
                  "type": "string"
                },
                "username": {
                  "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f@]{1,64}$",
                  "type": "string"
                }
              },
              "required": [
                "userId",
                "name",
                "at"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "error": {
            "maxLength": 1000,
            "type": "string"
          },
          "ignoredSenders": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "at": {
                  "minimum": 0,
                  "type": "integer"
                },
                "userId": {
                  "maxLength": 256,
                  "minLength": 1,
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
                  "type": "string"
                },
                "username": {
                  "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f@]{1,64}$",
                  "type": "string"
                }
              },
              "required": [
                "userId",
                "at"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "kind": {
            "pattern": "^[a-z][a-z0-9_]{0,31}$",
            "type": "string"
          },
          "link": {
            "maxLength": 256,
            "type": "string"
          },
          "service": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "serviceUsername": {
            "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f@]{1,64}$",
            "type": "string"
          },
          "state": {
            "anyOf": [
              {
                "const": "disabled",
