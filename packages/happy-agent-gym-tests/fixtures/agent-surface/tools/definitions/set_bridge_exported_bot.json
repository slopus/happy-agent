              {
                "const": "ask",
                "type": "string"
              },
              {
                "const": "ignore",
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "kind",
          "service",
          "botId",
          "state",
          "allowedUsers",
          "unknownSenders",
          "ignoredSenders",
          "accessRequests",
          "deniedUsers",
          "conversations"
        ],
        "type": "object"
      },
      "tokenFile": {
        "type": "string"
