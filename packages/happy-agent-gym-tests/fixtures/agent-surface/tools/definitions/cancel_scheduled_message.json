{
  "autoReview": "never",
  "capabilities": [
    "Wait and schedule durable messages for future delivery."
  ],
  "defer": true,
  "description": "Withdraw a message you scheduled, by ID. A message already delivered stays delivered.",
  "durable": true,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "scheduleId": {
        "maxLength": 32,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9]*$",
        "type": "string"
      }
    },
    "required": [
      "scheduleId"
    ],
    "type": "object"
  },
  "name": "cancel_scheduled_message",
  "returnType": {
    "additionalProperties": false,
    "properties": {
      "createdAt": {
        "maximum": 8640000000000000,
        "minimum": 0,
        "type": "integer"
      },
      "deliveredAt": {
        "maximum": 8640000000000000,
        "minimum": 0,
        "type": "integer"
      },
      "dueAt": {
        "maximum": 8640000000000000,
        "minimum": 0,
        "type": "integer"
      },
      "failure": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "id": {
        "maxLength": 32,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9]*$",
        "type": "string"
      },
      "message": {
        "maxLength": 50000,
        "minLength": 1,
        "type": "string"
      },
      "mutationId": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "senderAgentId": {
        "maxLength": 32,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9]*$",
        "type": "string"
      },
      "status": {
        "anyOf": [
          {
            "const": "pending",
            "type": "string"
          },
          {
            "const": "delivered",
            "type": "string"
          },
          {
            "const": "undelivered",
            "type": "string"
          },
          {
            "const": "cancelled",
            "type": "string"
          }
        ]
      },
      "targetAgentId": {
        "maxLength": 32,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9]*$",
        "type": "string"
      },
      "updatedAt": {
        "maximum": 8640000000000000,
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "id",
      "senderAgentId",
      "targetAgentId",
      "message",
      "dueAt",
      "status",
      "createdAt",
      "updatedAt"
    ],
    "type": "object"
  },
  "searchKeywords": [
    "cancel reminder",
    "withdraw future message",
    "stop scheduled delivery"
  ]
}
