{
  "capabilities": [
    "Create, list, message, and archive persistent tasks with their own folders."
  ],
  "defer": true,
  "description": "List persistent tasks on this installation: user-visible conversations, each with its own folder. Each line shows the task's ID, name, status, owner, creating agent, and folder. Omit scope or pass \"all\" for every task, oldest first; pass \"joined\" for only the tasks the person you are working for joined, in the order they arranged their list. Omit status to include every status, or pass \"active\" or \"archived\". Results are paged; follow nextOffset until every task you need is read. Use send_task_message with a task's ID to talk to an active one.",
  "durable": false,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "limit": {
        "maximum": 50,
        "minimum": 1,
        "type": "integer"
      },
      "offset": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
      },
      "scope": {
        "anyOf": [
          {
            "const": "all",
            "type": "string"
          },
          {
            "const": "joined",
            "type": "string"
          }
        ]
      },
      "status": {
        "anyOf": [
          {
            "const": "active",
            "type": "string"
          },
          {
            "const": "archived",
            "type": "string"
          }
        ]
      }
    },
    "type": "object"
  },
  "name": "list_tasks",
  "reloadable": true,
  "returnType": {
    "properties": {
      "nextOffset": {
        "minimum": 0,
        "type": "integer"
      },
      "tasks": {
        "items": {
          "properties": {
            "owner": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "task": {
              "additionalProperties": false,
              "properties": {
                "agentId": {
                  "maxLength": 32,
                  "minLength": 2,
                  "pattern": "^[a-z][a-z0-9]*$",
                  "type": "string"
                },
                "archivedAt": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "createdAt": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "creatorAgentId": {
                  "maxLength": 32,
                  "minLength": 2,
                  "pattern": "^[a-z][a-z0-9]*$",
                  "type": "string"
                },
                "folderName": {
                  "maxLength": 64,
                  "minLength": 1,
                  "pattern": "^[a-z][a-z0-9_]{0,63}$",
                  "type": "string"
                },
                "id": {
                  "maxLength": 32,
                  "minLength": 2,
                  "pattern": "^[a-z][a-z0-9]*$",
                  "type": "string"
                },
                "name": {
                  "maxLength": 256,
                  "minLength": 1,
                  "pattern": "^(?=.*\\S)[^\\x00-\\x1f\\x7f]+$",
                  "type": "string"
                },
                "nameConfigured": {
                  "type": "boolean"
                },
                "ownerUserId": {
                  "maxLength": 32,
                  "minLength": 2,
                  "pattern": "^[a-z][a-z0-9]*$",
                  "type": "string"
                },
                "path": {
                  "maxLength": 4096,
                  "minLength": 1,
                  "type": "string"
                },
                "runnerId": {
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$",
                  "type": "string"
                },
                "shortName": {
                  "maxLength": 256,
                  "minLength": 1,
                  "pattern": "^(?=.*\\S)[^\\x00-\\x1f\\x7f]+$",
                  "type": "string"
                },
                "status": {
                  "anyOf": [
                    {
                      "const": "active",
                      "type": "string"
                    },
                    {
                      "const": "archived",
                      "type": "string"
                    }
                  ]
                },
                "updatedAt": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "version": {
                  "maximum": 9007199254740991,
                  "minimum": 1,
                  "type": "integer"
                },
                "workspaceId": {
                  "maxLength": 32,
                  "minLength": 2,
                  "pattern": "^[a-z][a-z0-9]*$",
                  "type": "string"
                },
                "workspaceUpdatedAt": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "workspaceVersion": {
                  "maximum": 9007199254740991,
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "name",
                "nameConfigured",
                "folderName",
                "workspaceId",
                "workspaceVersion",
                "workspaceUpdatedAt",
                "agentId",
                "path",
                "status",
                "version",
                "createdAt",
                "updatedAt"
              ],
              "type": "object"
            }
          },
          "required": [
            "task",
            "owner"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "total": {
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "tasks",
      "total"
    ],
    "type": "object"
  },
  "searchKeywords": [
    "task catalog",
    "open tasks",
    "task owners",
    "find task"
  ]
}
