{
  "capabilities": [
    "Create a named shared Markdown document Surface as an admin bot."
  ],
  "defer": true,
  "description": "Admin bots only: create a document Surface with optional initial Markdown, empty by default. Explicitly supply creatorUserId as a local Happy user ID or null; only null is allowed in standalone mode. The creator is the immutable author and joins their sidebar; null joins nobody in team mode and the local person in standalone mode. Revision audit identity remains the actual caller. Optionally supply an absolute PNG, JPEG, or WebP image path (8 MiB maximum).",
  "durable": true,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "creatorUserId": {
        "anyOf": [
          {
            "maxLength": 32,
            "minLength": 2,
            "pattern": "^[a-z][a-z0-9]*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "imagePath": {
        "maxLength": 4096,
        "minLength": 1,
        "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\)[^\\u0000]*$",
        "type": "string"
      },
      "name": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^(?=.*\\S)[^\\x00-\\x1f\\x7f]+$",
        "type": "string"
      },
      "text": {
        "maxLength": 262144,
        "pattern": "^[^\\u0000]*$",
        "type": "string"
      }
    },
    "required": [
      "name",
      "creatorUserId"
    ],
    "type": "object"
  },
  "name": "create_document_surface",
