                    },
                    {
                      "const": "archived",
                      "type": "string"
                    }
                  ]
                },
                "subtasks": {
                  "additionalProperties": false,
                  "properties": {
                    "active": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "total": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "total",
                    "active"
                  ],
                  "type": "object"
                },
                "workspaces": {
                  "additionalProperties": false,
                  "properties": {
                    "active": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "total": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "total",
                    "active"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "kind",
                "id",
                "name",
                "status",
                "createdAt",
                "lastActivityAt",
                "running",
                "agents"
              ],
              "type": "object"
            },
            "relation": {
              "anyOf": [
                {
                  "const": "same",
                  "type": "string"
                },
                {
                  "const": "contains",
                  "type": "string"
                },
                {
                  "const": "inside",
                  "type": "string"
                }
              ]
            }
          },
          "required": [
            "item",
            "relation"
          ],
          "type": "object"
        },
        "type": "array"
      }
    },
    "required": [
      "folder",
      "items",
      "agents",
      "at"
    ],
    "type": "object"
