{
  "autoReview": "never",
  "capabilities": [
    "Find shared Surfaces and their members."
  ],
  "defer": true,
  "description": "List shared Surface instances, their IDs, names, types, and joined people. Artifact, bot, and task Surfaces include their target's live name and ID while it is available, or an unavailable state without them. Document Surfaces include promptDocument: null, or the description admins gave it as one of the installation's important documents. Each todo, document, calendar, or System Monitor tool requires a Surface ID. Results are paged.",
  "durable": false,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "limit": {
        "maximum": 50,
        "minimum": 1,
        "type": "integer"
      },
      "offset": {
        "minimum": 0,
        "type": "integer"
      }
    },
    "type": "object"
  },
  "name": "list_surfaces",
  "returnType": {
    "properties": {
      "nextOffset": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ]
      },
      "surfaces": {
        "items": {
          "properties": {
            "chatAgentId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "creatorUserId": {
              "anyOf": [
                {
                  "maxLength": 32,
                  "minLength": 2,
                  "pattern": "^[a-z][a-z0-9]*$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "id": {
              "maxLength": 24,
              "minLength": 24,
              "pattern": "^[a-z][a-z0-9]{23}$",
              "type": "string"
            },
            "image": {
              "anyOf": [
                {
                  "properties": {
                    "thumbhash": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "thumbhash"
                  ],
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            },
            "members": {
              "items": {
                "properties": {
                  "joinedAt": {
                    "type": "integer"
                  },
                  "orderKey": {
                    "pattern": "^[0-9]*[1-9]$",
                    "type": "string"
                  },
                  "userId": {
                    "anyOf": [
                      {
                        "maxLength": 32,
                        "minLength": 2,
                        "pattern": "^[a-z][a-z0-9]*$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "joinedAt",
                  "orderKey",
                  "userId"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "name": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^(?=.*\\S)[^\\x00-\\x1f\\x7f]+$",
              "type": "string"
            },
            "promptDocument": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "description": {
                      "maxLength": 1024,
                      "minLength": 1,
                      "pattern": "\\S",
                      "type": "string"
                    },
                    "name": {
                      "maxLength": 256,
                      "minLength": 1,
                      "pattern": "^(?=.*\\S)[^\\x00-\\x1f\\x7f]+$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "description"
                  ],
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            },
            "target": {
              "anyOf": [
                {
                  "properties": {
                    "artifactId": {
                      "type": "string"
                    },
                    "botId": {
                      "not": {}
                    },
                    "hasImage": {
                      "type": "boolean"
                    },
                    "name": {
                      "maxLength": 256,
                      "minLength": 1,
                      "pattern": "^(?=.*\\S)[^\\x00-\\x1f\\x7f]+$",
                      "type": "string"
                    },
                    "state": {
                      "const": "available",
                      "type": "string"
                    },
                    "taskId": {
                      "not": {}
                    },
                    "type": {
                      "const": "artifact",
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "state",
                    "name",
                    "hasImage",
                    "version",
                    "type",
                    "artifactId"
                  ],
                  "type": "object"
                },
                {
                  "properties": {
                    "artifactId": {
                      "not": {}
                    },
                    "botId": {
                      "type": "string"
                    },
                    "hasImage": {
                      "type": "boolean"
                    },
                    "name": {
                      "maxLength": 256,
                      "minLength": 1,
                      "pattern": "^(?=.*\\S)[^\\x00-\\x1f\\x7f]+$",
                      "type": "string"
                    },
                    "state": {
                      "const": "available",
                      "type": "string"
                    },
                    "taskId": {
                      "not": {}
                    },
                    "type": {
                      "const": "bot",
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "state",
                    "name",
                    "hasImage",
                    "version",
                    "type",
                    "botId"
                  ],
                  "type": "object"
                },
                {
                  "properties": {
                    "artifactId": {
                      "not": {}
                    },
                    "botId": {
                      "not": {}
                    },
                    "hasImage": {
                      "const": false,
                      "type": "boolean"
                    },
                    "name": {
                      "maxLength": 256,
                      "minLength": 1,
                      "pattern": "^(?=.*\\S)[^\\x00-\\x1f\\x7f]+$",
                      "type": "string"
                    },
                    "state": {
                      "const": "available",
                      "type": "string"
                    },
                    "taskId": {
                      "type": "string"
                    },
                    "type": {
                      "const": "task",
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "state",
                    "name",
                    "hasImage",
                    "version",
                    "type",
                    "taskId"
                  ],
                  "type": "object"
                },
                {
                  "properties": {
                    "artifactId": {
                      "not": {}
                    },
                    "botId": {
                      "not": {}
                    },
                    "hasImage": {
                      "not": {}
                    },
                    "name": {
                      "not": {}
                    },
                    "state": {
                      "const": "unavailable",
                      "type": "string"
                    },
                    "taskId": {
                      "not": {}
                    },
                    "type": {
                      "anyOf": [
                        {
                          "const": "artifact",
                          "type": "string"
                        },
                        {
                          "const": "bot",
                          "type": "string"
                        },
                        {
                          "const": "task",
                          "type": "string"
                        }
                      ]
                    },
                    "version": {
                      "not": {}
                    }
                  },
                  "required": [
                    "type",
                    "state"
                  ],
                  "type": "object"
                }
              ]
            },
            "type": {
              "minLength": 1,
              "type": "string"
            },
            "updatedAt": {
              "type": "integer"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "image",
            "type",
            "members",
            "name",
            "updatedAt",
            "version"
          ],
          "type": "object"
        },
        "type": "array"
      }
    },
    "required": [
      "surfaces",
      "nextOffset"
    ],
    "type": "object"
  },
  "searchKeywords": [
    "list surfaces",
    "shared todo lists",
    "sidebar members"
  ]
}
