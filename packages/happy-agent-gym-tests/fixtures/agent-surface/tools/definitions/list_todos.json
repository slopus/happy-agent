{
  "capabilities": [
    "Read active, completed, or deleted todos in a Surface."
  ],
  "defer": true,
  "description": "List todos in one Surface, active by default. Active text starting with exact '# ' is a section heading, not an outstanding task; exclude headings from task counts. Do not trim text before checking that prefix. Use completed, deleted, or all to find older items. Keep returned versions for guarded edits. Results are paged.",
  "durable": false,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "limit": {
        "maximum": 50,
        "minimum": 1,
        "type": "integer"
      },
      "offset": {
        "minimum": 0,
        "type": "integer"
      },
      "scope": {
        "anyOf": [
          {
            "const": "active",
            "type": "string"
          },
          {
            "const": "completed",
            "type": "string"
          },
          {
            "const": "deleted",
            "type": "string"
          },
          {
            "const": "all",
            "type": "string"
          }
        ]
      },
      "surfaceId": {
        "maxLength": 24,
        "minLength": 24,
        "pattern": "^[a-z][a-z0-9]{23}$",
        "type": "string"
      }
    },
    "required": [
      "surfaceId"
    ],
    "type": "object"
  },
  "name": "list_todos",
  "returnType": {
    "properties": {
      "nextOffset": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ]
      },
      "todos": {
        "items": {
          "anyOf": [
            {
              "properties": {
                "authorUserId": {
                  "anyOf": [
                    {
                      "maxLength": 32,
                      "minLength": 2,
                      "pattern": "^[a-z][a-z0-9]*$",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "completedAt": {
                  "type": "null"
                },
                "createdAt": {
                  "type": "integer"
                },
                "deletedAt": {
                  "type": "null"
                },
                "id": {
                  "type": "string"
                },
                "orderKey": {
                  "pattern": "^[0-9]*[1-9]$",
                  "type": "string"
                },
                "status": {
                  "const": "active",
                  "type": "string"
                },
                "surfaceId": {
                  "maxLength": 24,
                  "minLength": 24,
                  "pattern": "^[a-z][a-z0-9]{23}$",
                  "type": "string"
                },
                "text": {
                  "maxLength": 10000,
                  "minLength": 1,
                  "pattern": "^(?=[\\s\\S]*\\S)[^\\x00-\\x08\\x0b-\\x1f\\x7f]+$",
                  "type": "string"
                },
                "updatedAt": {
                  "type": "integer"
                },
                "version": {
                  "type": "string"
                }
              },
              "required": [
                "createdAt",
                "id",
                "surfaceId",
                "text",
                "updatedAt",
