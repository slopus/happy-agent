{
  "autoReview": "never",
  "capabilities": [
    "Read the agent's durable conversation and tool history."
  ],
  "defer": true,
  "description": "Read or search the durable low-level history of any agent. The response lists the agents it concerns with their stable IDs, message counts, paths, and statuses; any stable Agent ID may be read, including one that has recorded nothing yet. Use this to investigate prior requests, decisions, reasoning, tool activity, and subagent work after a model change or whenever earlier context matters. This is not a user-facing chat export. Search examines stored block content, but each response is simplified and capped at 80,000 characters: provider-hidden reasoning is unavailable, only exposed thinking is readable, tool calls are summarized, tool outputs are truncated, and images are represented only by metadata. A requested message limit may therefore return fewer messages; continue with next_cursor or previous_cursor.",
  "durable": true,
  "inputSchema": {
    "properties": {
      "cursor": {
        "description": "Zero-based original history position. Use a returned previous_cursor or next_cursor to navigate. Cannot be combined with from.",
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
      },
      "from": {
        "anyOf": [
          {
            "const": "start",
            "type": "string"
          },
          {
            "const": "begin",
            "type": "string"
          },
          {
            "const": "beginning",
            "type": "string"
          },
          {
            "const": "end",
            "type": "string"
          },
          {
            "const": "last",
            "type": "string"
          }
        ],
        "description": "Read the first matching page with start, begin, or beginning; read the last matching page with end or last. Results are always chronological. Cannot be combined with cursor."
      },
      "include_tools": {
        "description": "Include simplified tool calls and truncated tool results. Defaults to true. This does not change what query searches.",
        "type": "boolean"
      },
      "limit": {
        "description": "Maximum matching messages to select before the 80,000-character response cap is applied. Defaults to 100 and cannot exceed 500. Large messages may return fewer; use the returned cursors to continue.",
        "maximum": 500,
        "minimum": 1,
        "type": "integer"
      },
      "query": {
        "description": "Case-insensitive text search across full stored conversation, thinking, tool names, arguments, and outputs.",
        "maxLength": 100000,
        "minLength": 1,
        "type": "string"
      },
      "roles": {
        "description": "Return only messages with one of these roles. \"user\" is a message the person actually sent; \"agent\" is a system-generated message such as a goal continuation or another agent's delivery.",
        "items": {
          "anyOf": [
            {
              "const": "user",
              "type": "string"
            },
            {
              "const": "agent",
              "type": "string"
            },
            {
              "const": "assistant",
              "type": "string"
            },
            {
              "const": "error",
              "type": "string"
            },
            {
              "const": "system",
              "type": "string"
            }
          ]
        },
        "maxItems": 5,
        "minItems": 1,
        "type": "array",
        "uniqueItems": true
      },
      "target": {
        "description": "Stable Agent ID. Omitted means the calling agent; an agent that has recorded nothing simply has an empty history.",
        "maxLength": 1024,
        "minLength": 1,
        "pattern": "^[^\\u0000\\r\\n]+$",
        "type": "string"
      }
    },
    "type": "object"
  },
  "name": "read_agent_history",
  "reloadable": true,
  "returnType": {
    "properties": {
      "agents": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "agent_id": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^\\u0000\\r\\n]+$",
              "type": "string"
            },
            "description": {
              "maxLength": 4000,
              "type": "string"
            },
            "message_count": {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            },
            "path": {
              "maxLength": 1024,
              "minLength": 1,
              "pattern": "^[^\\u0000\\r\\n]+$",
              "type": "string"
            },
            "status": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^\\u0000\\r\\n]+$",
              "type": "string"
            }
          },
          "required": [
            "agent_id",
            "message_count",
            "path",
            "status"
          ],
          "type": "object"
        },
        "maxItems": 256,
        "type": "array"
      },
      "cursor": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
      },
      "history": {
        "description": "Simplified chronological history, capped at 80,000 characters. It is not verbatim provider traffic and may omit or truncate tool and image details.",
        "maxLength": 80000,
        "type": "string"
      },
      "matched_messages": {
        "maximum": 100000,
        "minimum": 0,
        "type": "integer"
      },
      "next_cursor": {
        "description": "Stable original-history position for the next matching page. Omitted at the end.",
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
      },
      "previous_cursor": {
        "description": "Stable original-history position for the preceding matching page. Omitted at the beginning.",
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
      },
      "returned_messages": {
        "description": "Messages actually returned after filtering and the character cap; this can be lower than limit.",
        "maximum": 500,
        "minimum": 0,
        "type": "integer"
      },
      "stats": {
        "properties": {
          "matched": {
            "additionalProperties": false,
            "properties": {
              "assistant_messages": {
                "maximum": 100000,
                "minimum": 0,
                "type": "integer"
              },
              "messages": {
                "maximum": 100000,
                "minimum": 0,
                "type": "integer"
              },
              "text_characters": {
                "maximum": 204800000000000,
                "minimum": 0,
                "type": "integer"
              },
              "thinking_blocks": {
                "maximum": 204800000,
                "minimum": 0,
                "type": "integer"
              },
              "tool_calls": {
                "maximum": 204800000,
                "minimum": 0,
                "type": "integer"
              },
              "tool_results": {
                "maximum": 204800000,
                "minimum": 0,
                "type": "integer"
              },
              "user_messages": {
                "maximum": 100000,
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "assistant_messages",
              "messages",
              "text_characters",
              "thinking_blocks",
              "tool_calls",
              "tool_results",
              "user_messages"
            ],
            "type": "object"
          },
          "returned": {
            "additionalProperties": false,
            "properties": {
              "assistant_messages": {
                "maximum": 100000,
                "minimum": 0,
                "type": "integer"
              },
              "messages": {
                "maximum": 100000,
                "minimum": 0,
                "type": "integer"
              },
              "text_characters": {
                "maximum": 204800000000000,
                "minimum": 0,
                "type": "integer"
              },
              "thinking_blocks": {
                "maximum": 204800000,
                "minimum": 0,
                "type": "integer"
              },
              "tool_calls": {
                "maximum": 204800000,
                "minimum": 0,
                "type": "integer"
              },
              "tool_results": {
                "maximum": 204800000,
                "minimum": 0,
                "type": "integer"
              },
              "user_messages": {
                "maximum": 100000,
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "assistant_messages",
              "messages",
              "text_characters",
              "thinking_blocks",
              "tool_calls",
              "tool_results",
              "user_messages"
            ],
            "type": "object"
          },
          "total": {
            "additionalProperties": false,
            "properties": {
              "assistant_messages": {
                "maximum": 100000,
                "minimum": 0,
                "type": "integer"
              },
              "messages": {
                "maximum": 100000,
                "minimum": 0,
                "type": "integer"
              },
              "text_characters": {
                "maximum": 204800000000000,
                "minimum": 0,
                "type": "integer"
              },
              "thinking_blocks": {
                "maximum": 204800000,
                "minimum": 0,
                "type": "integer"
              },
              "tool_calls": {
                "maximum": 204800000,
                "minimum": 0,
                "type": "integer"
              },
              "tool_results": {
                "maximum": 204800000,
                "minimum": 0,
                "type": "integer"
              },
              "user_messages": {
                "maximum": 100000,
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "assistant_messages",
              "messages",
              "text_characters",
              "thinking_blocks",
              "tool_calls",
              "tool_results",
              "user_messages"
            ],
            "type": "object"
          }
        },
        "required": [
          "matched",
          "returned",
          "total"
        ],
        "type": "object"
      },
      "target": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^[^\\u0000\\r\\n]+$",
        "type": "string"
      },
      "total_messages": {
        "maximum": 100000,
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "agents",
      "cursor",
      "history",
      "matched_messages",
      "returned_messages",
      "stats",
      "target",
      "total_messages"
    ],
    "type": "object"
  },
  "searchKeywords": [
    "prior messages",
    "previous tool calls",
    "agent conversation history"
  ],
  "transactional": true
}
