{
  "autoReview": "never",
  "capabilities": [
    "Switch a direct subtask to another model, effort, or provider."
  ],
  "defer": true,
  "description": "Switch one of your direct subtasks to another model, effort, provider, or service tier. Only its coordinating bot, task, or subtask may do this.\n\nChoose from the same options as create_subtask, listed by agent_options; harness and provider default to yours when they serve the model.\n\nThis sends the subtask a short message from you carrying the new model, exactly as a person switches models from its conversation. A working subtask switches after its current step and carries on; an idle one wakes on the new model and replies briefly. A model that cannot read the earlier conversation starts fresh with a handoff notice.\n\nKeep a subtask on one model unless its model is failing or wrong for the work. To give it new instructions as well, use send_agent_message with the same model fields instead.",
  "durable": true,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "agentId": {
        "maxLength": 32,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9]*$",
        "type": "string"
      },
      "effort": {
        "anyOf": [
          {
            "const": "off",
            "type": "string"
          },
          {
            "const": "minimal",
            "type": "string"
          },
          {
            "const": "low",
            "type": "string"
          },
          {
            "const": "medium",
            "type": "string"
          },
          {
            "const": "high",
            "type": "string"
          },
          {
            "const": "xhigh",
            "type": "string"
          },
          {
            "const": "max",
            "type": "string"
          }
        ]
      },
      "harness": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "model": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "provider": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "serviceTier": {
        "const": "priority",
        "type": "string"
      }
    },
    "required": [
      "agentId",
      "model",
      "effort"
    ],
    "type": "object"
  },
  "name": "switch_subtask_model",
  "returnType": {
    "additionalProperties": false,
    "properties": {
      "agentId": {
        "maxLength": 32,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9]*$",
        "type": "string"
      },
      "effort": {
        "anyOf": [
          {
            "const": "off",
            "type": "string"
          },
          {
            "const": "minimal",
            "type": "string"
          },
          {
            "const": "low",
            "type": "string"
          },
          {
            "const": "medium",
            "type": "string"
          },
          {
            "const": "high",
            "type": "string"
          },
          {
            "const": "xhigh",
            "type": "string"
          },
          {
            "const": "max",
            "type": "string"
          }
        ]
      },
      "model": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "modelName": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "provider": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "serviceTier": {
        "const": "priority",
        "type": "string"
      }
    },
    "required": [
      "agentId",
      "model",
