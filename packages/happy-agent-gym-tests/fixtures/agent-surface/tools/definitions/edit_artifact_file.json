{
  "capabilities": [
    "Publish Markdown documents, HTML pages, and Gen UI documents with their images and other files, images, image series, videos, and documents as versioned artifacts, and list, read, update, and delete them."
  ],
  "defer": true,
  "description": "Performs exact string replacements in one text file of an artifact, straight in this installation's artifact catalog. The edit applies to the artifact's latest version and makes its next version, keeping every earlier one, and records the change as made by you.\nUsage:\n- When editing text from read_artifact_file output, preserve the exact indentation as it appears AFTER the line number prefix: a line number, then a tab. Never include any part of the prefix in old_string or new_string.\n- The edit will FAIL if old_string is not unique in the file. Either provide a larger string with more surrounding context to make it unique or use replace_all to change every instance of old_string.\n- Use replace_all for replacing and renaming strings across the file.\n- The edit also fails, changing nothing, when someone else changed the artifact while it ran; read the file again and repeat it.",
  "durable": true,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "artifactId": {
        "maxLength": 32,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9]*$",
        "type": "string"
      },
      "new_string": {
        "description": "The text to replace it with (must be different from old_string)",
        "type": "string"
      },
      "old_string": {
        "description": "The text to replace",
        "type": "string"
      },
      "path": {
        "description": "The path of the file inside the artifact, such as \"index.html\"",
        "maxLength": 1024,
        "minLength": 1,
        "pattern": "^(?!\\.\\.?(?:/|$))(?!.*/\\.\\.?(?:/|$))[^/\\\\\\x00-\\x1f\\x7f]{1,255}(?:/[^/\\\\\\x00-\\x1f\\x7f]{1,255})*$",
        "type": "string"
      },
      "replace_all": {
        "default": false,
        "description": "Replace all occurrences of old_string (default false)",
        "type": "boolean"
      }
    },
    "required": [
      "artifactId",
      "path",
      "old_string",
      "new_string"
    ],
    "type": "object"
  },
