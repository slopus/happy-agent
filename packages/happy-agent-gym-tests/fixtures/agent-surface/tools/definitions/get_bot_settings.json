{
  "capabilities": [
    "Read and change what each bot and the agents under it may reach."
  ],
  "defer": true,
  "description": "Read one bot's settings: which secrets it and every agent under it may use, whether they may reach other projects, workspaces, tasks, bots, and agents, and where their commands run. Find bot IDs with list_bots. Only active admin bots may use it. Pass the returned settings unchanged as previous to update_bot_settings.",
  "durable": true,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "botId": {
        "maxLength": 32,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9]*$",
        "type": "string"
      }
    },
    "required": [
      "botId"
    ],
    "type": "object"
  },
  "name": "get_bot_settings",
  "reloadable": true,
  "returnType": {
    "additionalProperties": false,
    "properties": {
      "botId": {
        "maxLength": 32,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9]*$",
        "type": "string"
      },
      "name": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^(?=.*\\S)[^\\x00-\\x1f\\x7f]+$",
        "type": "string"
      },
      "settings": {
        "additionalProperties": false,
        "properties": {
          "allowedSecretIds": {
            "anyOf": [
              {
                "items": {
                  "maxLength": 32,
                  "minLength": 2,
                  "pattern": "^[a-z][a-z0-9_-]*$",
                  "type": "string"
                },
                "maxItems": 256,
                "type": "array",
                "uniqueItems": true
              },
              {
                "type": "null"
              }
            ]
          },
          "compute": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "host",
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "image": {
                    "maxLength": 512,
                    "minLength": 1,
                    "pattern": "^[^\\u0000-\\u0020\\u007f]+$",
                    "type": "string"
                  },
                  "type": {
                    "const": "docker",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "image"
                ],
                "type": "object"
              }
            ]
          },
          "crossWorkspace": {
            "type": "boolean"
          },
          "stories": {
            "type": "boolean"
          }
        },
        "required": [
          "allowedSecretIds",
          "crossWorkspace",
          "compute"
        ],
        "type": "object"
      }
    },
    "required": [
      "botId",
      "name",
      "settings"
    ],
    "type": "object"
  },
  "searchKeywords": [
    "bot settings",
    "restrict bot",
    "bot permissions",
    "lock down bot"
  ]
}
