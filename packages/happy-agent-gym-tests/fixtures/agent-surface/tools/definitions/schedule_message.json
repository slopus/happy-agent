        "minimum": 0,
        "type": "integer"
      },
      "deliveredAt": {
        "maximum": 8640000000000000,
        "minimum": 0,
        "type": "integer"
      },
      "dueAt": {
        "maximum": 8640000000000000,
        "minimum": 0,
        "type": "integer"
      },
      "failure": {
