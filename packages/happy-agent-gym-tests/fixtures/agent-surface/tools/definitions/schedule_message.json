        "minLength": 1,
        "type": "string"
      },
      "id": {
        "maxLength": 32,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9]*$",
        "type": "string"
      },
      "message": {
        "maxLength": 50000,
        "minLength": 1,
