{
  "autoReview": "never",
  "capabilities": [
    "Wait and schedule durable messages for future delivery."
  ],
  "defer": true,
  "description": "Send a message at a future time to any agent whose ID you know, including yourself. Give the time as a duration in `in`, or as a date in `at` written as ISO 8601, RFC 2822, or a Unix timestamp. The message is kept and delivered even if this session restarts first.",
  "durable": true,
