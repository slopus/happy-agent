    "properties": {
      "input": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "agent_id": {
                "maxLength": 32,
                "minLength": 2,
                "pattern": "^[a-z][a-z0-9]*$",
                "type": "string"
              },
              "in": {
                "anyOf": [
                  {
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "additionalProperties": false,
                    "minProperties": 1,
                    "properties": {
                      "days": {
                        "maximum": 8640000000000000,
                        "minimum": 0,
                        "type": "number"
                      },
                      "hours": {
                        "maximum": 8640000000000000,
                        "minimum": 0,
                        "type": "number"
                      },
                      "minutes": {
                        "maximum": 8640000000000000,
                        "minimum": 0,
                        "type": "number"
                      },
                      "seconds": {
                        "maximum": 8640000000000000,
                        "minimum": 0,
                        "type": "number"
                      }
                    },
                    "type": "object"
                  }
                ]
              },
              "message": {
                "maxLength": 50000,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "agent_id",
              "message",
              "in"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "agent_id": {
                "maxLength": 32,
                "minLength": 2,
                "pattern": "^[a-z][a-z0-9]*$",
                "type": "string"
              },
              "at": {
                "anyOf": [
                  {
                    "maxLength": 128,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "maximum": 8640000000000000,
                    "minimum": -8640000000000000,
                    "type": "number"
                  }
                ]
              },
              "message": {
                "maxLength": 50000,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "agent_id",
              "message",
              "at"
            ],
            "type": "object"
          }
        ]
      }
    },
    "required": [
      "input"
    ],
    "type": "object"
  },
  "name": "schedule_message",
