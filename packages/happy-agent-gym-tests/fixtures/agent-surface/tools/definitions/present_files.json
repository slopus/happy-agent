          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "maxItems": 10,
        "minItems": 1,
        "type": "array"
      },
      "layout": {
        "description": "Optional small HTML fragment with inline CSS arranging the files; leave it out for the automatic layout",
        "maxLength": 1048576,
        "type": "string"
      }
    },
    "required": [
      "filepaths"
    ],
    "type": "object"
  },
