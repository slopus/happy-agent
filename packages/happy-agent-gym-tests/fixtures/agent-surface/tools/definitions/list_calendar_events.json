                                    "type": "string"
                                  },
                                  {
                                    "const": "saturday",
                                    "type": "string"
                                  },
                                  {
                                    "const": "sunday",
                                    "type": "string"
                                  }
                                ]
                              },
                              "maxItems": 7,
                              "minItems": 1,
                              "type": "array",
                              "uniqueItems": true
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
