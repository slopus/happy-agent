{
  "capabilities": [
    "Read the events of a shared calendar in a date range."
  ],
  "defer": true,
  "description": "List the event occurrences of one calendar Surface that overlap a range of at most 100 days, with the events they belong to. Give from and to as local dates (YYYY-MM-DD, meaning midnight) or local date-times in timeZone, the IANA zone the person thinks in. Happy expands recurring events for you; never compute repeats yourself. Occurrence times are written in timeZone with offsets, as {kind:'timed', start, end} or all-day dates; each names its eventId and index in the series. Event timing is written in the event's own zone. Keep event versions for guarded edits. At most 200 occurrences are returned in time order; when truncated is true, read a narrower range.",
  "durable": false,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "from": {
        "maxLength": 40,
        "minLength": 10,
        "type": "string"
      },
      "surfaceId": {
        "maxLength": 24,
        "minLength": 24,
        "pattern": "^[a-z][a-z0-9]{23}$",
        "type": "string"
      },
      "timeZone": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(?:/[A-Za-z0-9_+-]+)*$",
        "type": "string"
      },
      "to": {
        "maxLength": 40,
        "minLength": 10,
        "type": "string"
      }
    },
    "required": [
      "surfaceId",
      "from",
      "to",
      "timeZone"
    ],
    "type": "object"
  },
  "name": "list_calendar_events",
