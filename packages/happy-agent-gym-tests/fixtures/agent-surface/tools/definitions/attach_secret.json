{
  "capabilities": [
    "List and attach registered secret references without revealing values."
  ],
  "defer": true,
  "description": "Attach a registered secret reference to this exact agent. This changes availability only; it never returns the secret value.",
  "durable": true,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "secretId": {
        "maxLength": 32,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9_-]*$",
        "type": "string"
      }
    },
    "required": [
      "secretId"
    ],
    "type": "object"
  },
  "name": "attach_secret",
  "returnType": {
    "additionalProperties": false,
    "properties": {
      "attachment": {
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "id": {
            "maxLength": 32,
            "minLength": 2,
            "pattern": "^[a-z][a-z0-9]*$",
            "type": "string"
          },
          "secretId": {
            "maxLength": 32,
            "minLength": 2,
            "pattern": "^[a-z][a-z0-9_-]*$",
            "type": "string"
          },
          "target": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "maxLength": 32,
                "minLength": 2,
                "pattern": "^[a-z][a-z0-9]*$",
                "type": "string"
              },
              "type": {
                "anyOf": [
                  {
                    "const": "project",
                    "type": "string"
                  },
                  {
                    "const": "workspace",
                    "type": "string"
                  },
                  {
                    "const": "agent",
                    "type": "string"
                  }
                ]
              }
            },
            "required": [
              "type",
              "id"
            ],
            "type": "object"
          }
        },
        "required": [
          "id",
          "secretId",
          "target",
          "createdAt"
        ],
        "type": "object"
      },
      "secret": {
        "additionalProperties": false,
        "properties": {
          "availableToAgents": {
            "type": "boolean"
          },
          "createdAt": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "description": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "environmentVariables": {
            "items": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            "maxItems": 256,
            "type": "array",
            "uniqueItems": true
          },
          "id": {
            "maxLength": 32,
            "minLength": 2,
            "pattern": "^[a-z][a-z0-9_-]*$",
            "type": "string"
          },
          "managed": {
            "type": "boolean"
          },
          "updatedAt": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "version": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "description",
          "environmentVariables",
          "managed",
          "availableToAgents",
          "version",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      }
    },
    "required": [
      "attachment",
      "secret"
    ],
    "type": "object"
  },
  "searchKeywords": [
    "attach credentials",
    "enable secret scope",
    "secret reference availability"
  ],
  "transactional": true
}
