{
  "capabilities": [
    "List and attach registered secret references without revealing values."
  ],
  "defer": true,
  "description": "List bounded secret references and environment-variable names. Secret values are never available to the model.",
  "durable": true,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "cursor": {
        "maxLength": 32,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9_-]*$",
        "type": "string"
      },
      "limit": {
        "maximum": 50,
        "minimum": 1,
        "type": "integer"
      }
    },
    "type": "object"
  },
  "name": "list_secrets",
  "reloadable": true,
  "returnType": {
    "additionalProperties": false,
    "properties": {
      "nextCursor": {
        "anyOf": [
          {
            "maxLength": 32,
            "minLength": 2,
            "pattern": "^[a-z][a-z0-9_-]*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "secrets": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "availableToAgents": {
              "type": "boolean"
            },
            "createdAt": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "description": {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            "environmentVariables": {
              "items": {
                "maxLength": 256,
                "minLength": 1,
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "type": "string"
              },
              "maxItems": 256,
              "type": "array",
              "uniqueItems": true
            },
            "id": {
              "maxLength": 32,
              "minLength": 2,
              "pattern": "^[a-z][a-z0-9_-]*$",
              "type": "string"
            },
            "managed": {
              "type": "boolean"
            },
            "updatedAt": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "version": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            }
          },
          "required": [
            "id",
            "description",
            "environmentVariables",
            "managed",
            "availableToAgents",
            "version",
            "createdAt",
            "updatedAt"
          ],
          "type": "object"
        },
        "maxItems": 100,
        "type": "array"
      }
    },
    "required": [
      "secrets",
      "nextCursor"
    ],
    "type": "object"
  },
  "searchKeywords": [
    "secret catalog",
    "credential references",
    "environment variable names"
  ]
}
