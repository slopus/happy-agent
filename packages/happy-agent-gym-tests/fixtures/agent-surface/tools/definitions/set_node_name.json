{
  "capabilities": [
    "Set this Happy Agent installation's display name and avatar."
  ],
  "defer": true,
  "description": "Set this Happy Agent daemon's own display name. This is independent of the P2P name, bot names, and your human's profile. Only active admin bots may use it.",
  "durable": true,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "name": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
        "type": "string"
      }
    },
    "required": [
      "name"
    ],
    "type": "object"
  },
  "name": "set_node_name",
  "requiresAutoOrFullAccess": true,
  "returnType": {
    "properties": {
      "avatar": {
        "anyOf": [
          {
            "properties": {
              "thumbhash": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "thumbhash"
            ],
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
      },
      "name": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
        "type": "string"
      }
    },
    "required": [
      "name",
      "avatar"
    ],
    "type": "object"
  },
  "searchKeywords": [
    "node",
    "daemon",
    "installation",
    "name",
    "rename",
    "display name"
  ]
}
