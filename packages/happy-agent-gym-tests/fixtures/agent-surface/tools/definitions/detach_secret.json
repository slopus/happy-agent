{
  "capabilities": [
    "List and attach registered secret references without revealing values."
  ],
  "defer": true,
  "description": "Detach a secret reference from this exact agent. The result contains only identifiers and never the secret value.",
  "durable": true,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "secretId": {
        "maxLength": 32,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9_-]*$",
        "type": "string"
      }
    },
    "required": [
      "secretId"
    ],
    "type": "object"
  },
  "name": "detach_secret",
  "returnType": {
    "additionalProperties": false,
    "properties": {
      "attachment": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "createdAt": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "id": {
                "maxLength": 32,
                "minLength": 2,
                "pattern": "^[a-z][a-z0-9]*$",
                "type": "string"
              },
              "secretId": {
                "maxLength": 32,
                "minLength": 2,
                "pattern": "^[a-z][a-z0-9_-]*$",
                "type": "string"
              },
              "target": {
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "maxLength": 32,
                    "minLength": 2,
                    "pattern": "^[a-z][a-z0-9]*$",
                    "type": "string"
                  },
                  "type": {
                    "anyOf": [
                      {
                        "const": "project",
                        "type": "string"
                      },
                      {
                        "const": "workspace",
                        "type": "string"
                      },
                      {
                        "const": "agent",
                        "type": "string"
                      }
                    ]
                  }
                },
                "required": [
                  "type",
                  "id"
                ],
                "type": "object"
              }
            },
            "required": [
              "id",
              "secretId",
              "target",
              "createdAt"
            ],
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
      },
      "detached": {
        "type": "boolean"
      }
    },
    "required": [
      "detached",
      "attachment"
    ],
    "type": "object"
  },
  "searchKeywords": [
    "detach credentials",
    "disable secret scope",
    "remove secret reference"
  ],
  "transactional": true
}
