{
  "autoPermissionInstructions": "Enabling Tailcat makes this Happy Agent API reachable from the internet through an account-free tunnel. Disabling it closes that tunnel.",
  "capabilities": [
    "Enable, disable, and inspect Tailcat internet exposure."
  ],
  "defer": true,
  "description": "Enable or disable Tailcat internet exposure for this Happy Agent installation. Enabling opens an account-free Tailcat tunnel around the active API transport and keeps its stable identity across restarts. Happy Agent API authentication remains in force.",
  "durable": true,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean"
      }
    },
    "required": [
      "enabled"
    ],
    "type": "object"
  },
  "name": "set_tailcat_enabled",
  "requiresAutoOrFullAccess": true,
  "returnType": {
    "additionalProperties": false,
    "properties": {
      "address": {
        "maxLength": 8192,
        "minLength": 3,
        "pattern": "^tc[A-Za-z0-9_-]+$",
        "type": "string"
      },
      "enabled": {
        "type": "boolean"
      },
      "error": {
        "maxLength": 8192,
        "minLength": 1,
        "type": "string"
      },
      "port": {
        "maximum": 65535,
        "minimum": 1,
        "type": "integer"
      },
      "state": {
        "anyOf": [
          {
            "const": "disabled",
            "type": "string"
          },
          {
            "const": "starting",
            "type": "string"
          },
          {
            "const": "open",
            "type": "string"
          },
          {
            "const": "stopping",
            "type": "string"
          },
          {
            "const": "failed",
            "type": "string"
          }
        ]
      }
    },
    "required": [
      "enabled",
      "state"
    ],
    "type": "object"
  },
  "searchKeywords": [
    "enable Tailcat",
    "disable internet tunnel",
    "expose team server"
  ]
}
