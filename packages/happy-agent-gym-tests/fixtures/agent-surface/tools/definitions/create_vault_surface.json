{
  "capabilities": [
    "Create a named shared vault Surface for files as an admin bot."
  ],
  "defer": true,
  "description": "Admin bots only: create a named vault Surface, a shared tree of folders, files, and small web sites that keeps earlier versions of every file. Explicitly supply creatorUserId as a local Happy user ID or null; only null is allowed in standalone mode. The immutable creator joins their sidebar; null joins nobody in team mode and the local person in standalone mode. Optionally supply an absolute PNG, JPEG, or WebP image path (8 MiB maximum) and a retention policy; without one the vault keeps every version for a day, one a day until 30 days, one a week after that, and holds deleted entries in its Trash for 30 days.",
  "durable": true,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "creatorUserId": {
        "anyOf": [
          {
            "maxLength": 32,
            "minLength": 2,
            "pattern": "^[a-z][a-z0-9]*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "imagePath": {
        "maxLength": 4096,
        "minLength": 1,
        "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\)[^\\u0000]*$",
        "type": "string"
      },
      "name": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^(?=.*\\S)[^\\x00-\\x1f\\x7f]+$",
        "type": "string"
      },
      "retention": {
        "additionalProperties": false,
        "properties": {
          "keepAllDays": {
            "maximum": 36500,
            "minimum": 0,
            "type": "integer"
          },
          "maxAgeDays": {
            "anyOf": [
              {
                "maximum": 36500,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxVersions": {
            "anyOf": [
              {
                "maximum": 10000,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "thinning": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "afterDays": {
                  "maximum": 36500,
                  "minimum": 0,
                  "type": "integer"
                },
                "everyDays": {
                  "maximum": 3650,
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "afterDays",
                "everyDays"
              ],
              "type": "object"
            },
            "maxItems": 8,
            "type": "array"
          },
          "trashDays": {
            "anyOf": [
              {
                "maximum": 3650,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "keepAllDays",
          "maxAgeDays",
          "maxVersions",
          "thinning",
          "trashDays"
        ],
        "type": "object"
      }
    },
    "required": [
      "name",
      "creatorUserId"
    ],
    "type": "object"
  },
