{
  "autoPermissionInstructions": "Updating a secret mutates the global secret catalog. Inline values stay in the tool transcript. A dotenv source also reads one absolute host file.",
  "capabilities": [
    "Create, update, list, and attach registered secret references without revealing values."
  ],
  "defer": true,
  "description": "Update a global secret from exactly one replacement source: inline environment arguments or an absolute host .env file. Removed variables do not linger. Safe metadata is returned; attachments are unchanged.",
  "durable": false,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "availableToAgents": {
        "description": "Whether agents may attach this reference to commands. Omit to preserve its current setting.",
        "type": "boolean"
      },
      "description": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "dotenvFile": {
        "description": "Absolute path to a UTF-8 .env file whose complete environment bundle should be stored. The file is read host-side after review; its values are never returned.",
        "maxLength": 4096,
        "minLength": 1,
        "pattern": "^[^\\u0000]+$",
        "type": "string"
      },
      "environment": {
        "additionalProperties": false,
        "maxProperties": 256,
        "minProperties": 1,
        "patternProperties": {
          "^[A-Za-z_][A-Za-z0-9_]*$": {
            "maxLength": 65536,
            "pattern": "^[^\\u0000]*$",
            "type": "string"
          }
        },
        "type": "object"
      },
      "secretId": {
        "maxLength": 32,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9_-]*$",
        "type": "string"
      }
    },
    "required": [
      "secretId"
    ],
    "type": "object"
  },
  "name": "update_secret",
  "requiresAutoOrFullAccess": true,
  "returnType": {
    "additionalProperties": false,
    "properties": {
      "secret": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "availableToAgents": {
                "type": "boolean"
              },
              "createdAt": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "description": {
                "maxLength": 2000,
                "minLength": 1,
                "type": "string"
              },
              "environmentVariables": {
                "items": {
                  "maxLength": 256,
                  "minLength": 1,
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                  "type": "string"
                },
                "maxItems": 256,
                "type": "array",
                "uniqueItems": true
              },
              "id": {
                "maxLength": 32,
                "minLength": 2,
                "pattern": "^[a-z][a-z0-9_-]*$",
                "type": "string"
              },
              "managed": {
                "type": "boolean"
              },
              "updatedAt": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "version": {
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "type": "string"
              }
            },
            "required": [
              "id",
              "description",
              "environmentVariables",
              "managed",
              "availableToAgents",
              "version",
              "createdAt",
              "updatedAt"
            ],
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "secret"
    ],
    "type": "object"
  },
  "searchKeywords": [
    "replace secret",
    "rotate credentials",
    "update dotenv"
  ]
}
