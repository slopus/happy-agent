{
  "autoReview": "never",
  "capabilities": [
    "List, create, and message persistent bots.",
    "Find bots without avatars."
  ],
  "defer": true,
  "description": "List bots on this installation, including archived bots: persistent single-conversation assistants, each with its own folder. The result includes each bot's ID, display name, username, status, avatar status, and the folder it works in. Omit hasAvatar to list all bots, set it to false to show only bots without an avatar, or true to show only bots with one. Use send_bot_message with a bot's ID to talk to an active one.",
  "durable": false,
  "inputSchema": {
    "properties": {
      "hasAvatar": {
        "type": "boolean"
      }
    },
    "type": "object"
  },
  "name": "list_bots",
  "reloadable": true,
  "returnType": {
    "properties": {
      "bots": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "agentId": {
              "maxLength": 32,
              "minLength": 2,
              "pattern": "^[a-z][a-z0-9]*$",
              "type": "string"
            },
            "archivedAt": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "avatar": {
              "properties": {
                "kind": {
                  "const": "image",
                  "type": "string"
                },
                "source": {
                  "anyOf": [
                    {
                      "const": "user",
                      "type": "string"
                    },
                    {
                      "const": "generated",
                      "type": "string"
                    }
                  ]
                },
                "thumbhash": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "source",
                "thumbhash"
              ],
              "type": "object"
            },
            "createdAt": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "id": {
              "maxLength": 32,
              "minLength": 2,
              "pattern": "^[a-z][a-z0-9]*$",
              "type": "string"
            },
            "isAdmin": {
              "type": "boolean"
            },
            "name": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^(?=.*\\S)[^\\x00-\\x1f\\x7f]+$",
              "type": "string"
            },
            "nameConfigured": {
              "type": "boolean"
            },
            "orderKey": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[0-9]+$",
              "type": "string"
            },
            "path": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "runnerId": {
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            "shortName": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^(?=.*\\S)[^\\x00-\\x1f\\x7f]+$",
              "type": "string"
            },
            "status": {
              "anyOf": [
                {
                  "const": "active",
                  "type": "string"
                },
                {
                  "const": "archived",
                  "type": "string"
                }
              ]
            },
            "systemKey": {
              "const": "chief_of_staff",
              "type": "string"
            },
            "updatedAt": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "username": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            "version": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "workspaceId": {
              "maxLength": 32,
              "minLength": 2,
              "pattern": "^[a-z][a-z0-9]*$",
              "type": "string"
            },
            "workspaceUpdatedAt": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "workspaceVersion": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "id",
            "isAdmin",
            "name",
            "nameConfigured",
            "username",
            "workspaceId",
            "workspaceVersion",
            "workspaceUpdatedAt",
            "agentId",
            "path",
            "status",
            "orderKey",
            "version",
            "createdAt",
            "updatedAt"
          ],
          "type": "object"
        },
        "type": "array"
      }
    },
    "required": [
      "bots"
    ],
    "type": "object"
  },
  "searchKeywords": [
    "bot catalog",
    "persistent assistants",
    "bot roster",
    "missing avatars"
  ]
}
