{
  "capabilities": [
    "Add a todo to a shared Surface."
  ],
  "defer": true,
  "description": "Add a plain-text todo at the top of one shared Surface. For a section heading, start the text with exact '# ' (hash and space); it remains an ordinary ordered todo without a checkbox. Explicitly supply authorUserId as a local Happy user ID, or null for no attribution; only null is allowed in standalone mode. The author is immutable and separate from the revision's audit actor. This never creates a chat or joins anyone to the Surface.",
  "durable": true,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "authorUserId": {
        "anyOf": [
          {
            "maxLength": 32,
            "minLength": 2,
            "pattern": "^[a-z][a-z0-9]*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "surfaceId": {
        "maxLength": 24,
        "minLength": 24,
        "pattern": "^[a-z][a-z0-9]{23}$",
        "type": "string"
      },
      "text": {
        "maxLength": 10000,
        "minLength": 1,
        "pattern": "^(?=[\\s\\S]*\\S)[^\\x00-\\x08\\x0b-\\x1f\\x7f]+$",
        "type": "string"
      }
    },
    "required": [
      "surfaceId",
      "text",
      "authorUserId"
    ],
    "type": "object"
  },
  "name": "create_todo",
  "requiresAutoOrFullAccess": true,
