{
  "capabilities": [
    "Rename a shared Surface or change or remove its picture."
  ],
  "defer": true,
  "description": "Rename a shared Surface of any type, or change or remove its picture. Supply a new name, an absolute PNG, JPEG, or WebP imagePath (8 MiB maximum) to replace the picture, or imagePath null to remove it; at least one is required. Write or generate the image first, then point this tool at it. For artifact, bot, and task Surfaces the name is the label shown while the target is unavailable. Values equal to the current ones change nothing. This never joins anyone or changes the Surface's content.",
  "durable": true,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "imagePath": {
        "anyOf": [
          {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\)[^\\u0000]*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "name": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^(?=.*\\S)[^\\x00-\\x1f\\x7f]+$",
        "type": "string"
      },
      "surfaceId": {
        "maxLength": 24,
        "minLength": 24,
        "pattern": "^[a-z][a-z0-9]{23}$",
        "type": "string"
      }
    },
    "required": [
      "surfaceId"
    ],
    "type": "object"
  },
  "name": "update_surface",
  "requiresAutoOrFullAccess": true,
  "returnType": {
    "properties": {
      "chatAgentId": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "creatorUserId": {
        "anyOf": [
          {
            "maxLength": 32,
            "minLength": 2,
            "pattern": "^[a-z][a-z0-9]*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "id": {
        "maxLength": 24,
        "minLength": 24,
        "pattern": "^[a-z][a-z0-9]{23}$",
        "type": "string"
      },
      "image": {
        "anyOf": [
          {
            "properties": {
              "thumbhash": {
                "type": "string"
              }
            },
            "required": [
              "thumbhash"
            ],
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
      },
      "members": {
        "items": {
          "properties": {
            "joinedAt": {
              "type": "integer"
            },
            "orderKey": {
              "pattern": "^[0-9]*[1-9]$",
              "type": "string"
            },
            "userId": {
              "anyOf": [
                {
                  "maxLength": 32,
                  "minLength": 2,
                  "pattern": "^[a-z][a-z0-9]*$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "joinedAt",
            "orderKey",
            "userId"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "name": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^(?=.*\\S)[^\\x00-\\x1f\\x7f]+$",
        "type": "string"
      },
      "promptDocument": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "description": {
                "maxLength": 1024,
                "minLength": 1,
                "pattern": "\\S",
