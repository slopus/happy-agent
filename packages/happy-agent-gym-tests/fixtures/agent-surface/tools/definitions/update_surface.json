                "type": "string"
              },
              "state": {
                "const": "available",
                "type": "string"
              },
              "taskId": {
                "type": "string"
              },
              "type": {
                "const": "task",
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
