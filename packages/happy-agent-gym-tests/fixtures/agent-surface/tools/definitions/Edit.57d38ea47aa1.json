{
  "autoPermissionInstructions": "For Edit, request reviewed Full access for this file change with dangerouslyDisableSandbox: true. Protected and outside-workspace paths are also reviewed automatically without the flag. Approval elevates only this call; Read only and Workspace write never elevate.",
  "capabilities": [
    "Read and modify files, run shell commands, inspect images, and manage background processes."
  ],
  "defer": false,
  "description": "Performs exact string replacements in files.\n\nUsage:\n- When editing text from Read tool output, ensure you preserve the exact indentation (tabs/spaces) as it appears AFTER the line number prefix. The line number prefix format is: line number + tab. Everything after that is the actual file content to match. Never include any part of the line number prefix in the old_string or new_string.\n- ALWAYS prefer editing existing files in the codebase. NEVER write new files unless explicitly required.\n- Only use emojis if the user explicitly requests it. Avoid adding emojis to files unless asked.\n- The edit will FAIL if `old_string` is not unique in the file. Either provide a larger string with more surrounding context to make it unique or use `replace_all` to change every instance of `old_string`.\n- Use `replace_all` for replacing and renaming strings across the file. This parameter is useful if you want to rename a variable for instance.",
  "durable": false,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "dangerouslyDisableSandbox": {
        "description": "Request reviewed Full access for this edit in Auto mode. Protected and outside-workspace paths are also reviewed automatically when omitted.",
        "type": "boolean"
      },
      "file_path": {
        "description": "The absolute path to the file to modify",
        "type": "string"
      },
      "new_string": {
        "description": "The text to replace it with (must be different from old_string)",
        "type": "string"
      },
      "old_string": {
        "description": "The text to replace",
        "type": "string"
      },
      "replace_all": {
        "default": false,
        "description": "Replace all occurrences of old_string (default false)",
        "type": "boolean"
      }
    },
    "required": [
      "file_path",
      "old_string",
      "new_string"
    ],
    "type": "object"
  },
  "name": "Edit",
  "returnType": {
    "additionalProperties": false,
    "properties": {
      "path": {
        "type": "string"
      },
      "presentation": {
        "additionalProperties": false,
        "properties": {
          "files": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "added": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "deleted": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "hunks": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "lines": {
                        "items": {
                          "additionalProperties": false,
                          "properties": {
                            "kind": {
                              "anyOf": [
                                {
                                  "const": "context",
                                  "type": "string"
                                },
                                {
                                  "const": "add",
                                  "type": "string"
                                },
                                {
                                  "const": "delete",
                                  "type": "string"
                                }
                              ]
                            },
                            "text": {
                              "maxLength": 4000,
                              "type": "string"
                            }
                          },
                          "required": [
                            "kind",
                            "text"
                          ],
                          "type": "object"
                        },
                        "maxItems": 500,
                        "type": "array"
                      },
                      "newStart": {
                        "maximum": 9007199254740991,
                        "minimum": 0,
                        "type": "integer"
                      },
                      "oldStart": {
                        "maximum": 9007199254740991,
                        "minimum": 0,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "oldStart",
                      "newStart",
                      "lines"
                    ],
                    "type": "object"
                  },
                  "maxItems": 500,
                  "type": "array"
                },
                "kind": {
                  "anyOf": [
                    {
                      "const": "add",
                      "type": "string"
                    },
                    {
                      "const": "delete",
                      "type": "string"
                    },
                    {
                      "const": "update",
                      "type": "string"
                    }
                  ]
                },
                "language": {
                  "maxLength": 256,
                  "type": "string"
                },
                "omittedLines": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "path": {
                  "maxLength": 4000,
                  "type": "string"
                }
              },
              "required": [
                "path",
                "kind",
                "added",
                "deleted",
                "hunks"
              ],
              "type": "object"
            },
            "maxItems": 20,
            "type": "array"
          },
          "omittedFiles": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "type": {
            "const": "file_diff",
            "type": "string"
          }
        },
        "required": [
          "type",
          "files"
        ],
        "type": "object"
      },
      "replacements": {
        "type": "integer"
      }
    },
    "required": [
      "path",
      "replacements",
      "presentation"
    ],
    "type": "object"
  }
}
