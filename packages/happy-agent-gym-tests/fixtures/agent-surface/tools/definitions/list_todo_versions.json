                      "anyOf": [
                        {
                          "maxLength": 32,
                          "minLength": 2,
                          "pattern": "^[a-z][a-z0-9]*$",
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "completedAt": {
                      "anyOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "createdAt": {
                      "type": "integer"
                    },
                    "deletedAt": {
                      "type": "integer"
                    },
                    "id": {
                      "type": "string"
                    },
                    "orderKey": {
                      "type": "null"
                    },
                    "status": {
                      "const": "deleted",
                      "type": "string"
                    },
                    "surfaceId": {
                      "maxLength": 24,
                      "minLength": 24,
                      "pattern": "^[a-z][a-z0-9]{23}$",
                      "type": "string"
                    },
                    "text": {
                      "maxLength": 10000,
