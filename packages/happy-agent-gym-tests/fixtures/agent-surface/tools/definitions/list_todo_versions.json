                    },
                    "text": {
                      "maxLength": 10000,
                      "minLength": 1,
                      "pattern": "^(?=[\\s\\S]*\\S)[^\\x00-\\x08\\x0b-\\x1f\\x7f]+$",
                      "type": "string"
                    },
                    "updatedAt": {
                      "type": "integer"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "createdAt",
                    "id",
                    "surfaceId",
                    "text",
                    "updatedAt",
                    "version",
                    "completedAt",
                    "deletedAt",
                    "orderKey",
                    "status"
                  ],
                  "type": "object"
