{
  "autoReview": "never",
  "capabilities": [
    "Read a todo's permanent revisions and their authors."
  ],
  "defer": true,
  "description": "Read a bounded page of a todo's permanent full revisions and their actors, oldest first. Continue with nextAfterVersion.",
  "durable": false,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "afterVersion": {
        "type": "string"
      },
      "limit": {
        "maximum": 20,
        "minimum": 1,
        "type": "integer"
      },
      "surfaceId": {
        "maxLength": 24,
        "minLength": 24,
        "pattern": "^[a-z][a-z0-9]{23}$",
        "type": "string"
      },
      "todoId": {
        "maxLength": 32,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9]*$",
        "type": "string"
      }
    },
    "required": [
      "surfaceId",
      "todoId"
    ],
    "type": "object"
  },
  "name": "list_todo_versions",
  "returnType": {
    "properties": {
      "nextAfterVersion": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "versions": {
        "items": {
          "properties": {
            "actor": {
              "properties": {
                "agentId": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "userId": {
                  "anyOf": [
                    {
                      "maxLength": 32,
                      "minLength": 2,
                      "pattern": "^[a-z][a-z0-9]*$",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "agentId",
                "userId"
              ],
              "type": "object"
            },
            "source": {
              "anyOf": [
                {
                  "const": "api",
                  "type": "string"
                },
                {
                  "const": "tool",
                  "type": "string"
                }
              ]
            },
            "todo": {
              "anyOf": [
                {
                  "properties": {
                    "authorUserId": {
                      "anyOf": [
                        {
                          "maxLength": 32,
                          "minLength": 2,
                          "pattern": "^[a-z][a-z0-9]*$",
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "completedAt": {
                      "type": "null"
                    },
                    "createdAt": {
                      "type": "integer"
                    },
                    "deletedAt": {
                      "type": "null"
                    },
                    "id": {
                      "type": "string"
                    },
                    "orderKey": {
                      "pattern": "^[0-9]*[1-9]$",
                      "type": "string"
                    },
                    "status": {
                      "const": "active",
                      "type": "string"
                    },
                    "surfaceId": {
                      "maxLength": 24,
                      "minLength": 24,
                      "pattern": "^[a-z][a-z0-9]{23}$",
                      "type": "string"
                    },
                    "text": {
                      "maxLength": 10000,
                      "minLength": 1,
                      "pattern": "^(?=[\\s\\S]*\\S)[^\\x00-\\x08\\x0b-\\x1f\\x7f]+$",
                      "type": "string"
                    },
                    "updatedAt": {
                      "type": "integer"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "createdAt",
                    "id",
                    "surfaceId",
                    "text",
                    "updatedAt",
                    "version",
                    "completedAt",
                    "deletedAt",
