{
  "autoReview": "never",
  "capabilities": [
    "Find, inspect, and clean up stale bots, tasks, subtasks, projects, workspaces, and folders on this installation."
  ],
  "defer": true,
  "description": "Preview permanently deleting one bot, task, subtask, project, or workspace without changing anything. Lists every item it takes with it, every agent whose conversation would be erased (hidden subagents included, with running ones flagged), every folder and Git branch removed, and registered project folders that are kept. Returns the confirmation code delete_permanently needs. A deletion that would reach you or anything you run inside is refused. Only active admin bots may use it.",
  "durable": false,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "id": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "kind": {
        "anyOf": [
          {
            "const": "bot",
            "type": "string"
          },
          {
            "const": "task",
            "type": "string"
          },
          {
            "const": "subtask",
            "type": "string"
          },
          {
            "const": "project",
            "type": "string"
          },
          {
            "const": "workspace",
            "type": "string"
          }
        ]
      }
    },
    "required": [
      "kind",
      "id"
    ],
    "type": "object"
  },
  "name": "preview_delete",
  "reloadable": true,
  "returnType": {
    "additionalProperties": false,
    "properties": {
      "agents": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "agentId": {
              "minLength": 1,
              "type": "string"
            },
            "createdAt": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "folder": {
              "minLength": 1,
              "type": "string"
            },
            "lastActivityAt": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "state": {
              "anyOf": [
                {
                  "const": "running",
                  "type": "string"
                },
                {
                  "const": "idle",
                  "type": "string"
                },
                {
                  "const": "archived",
                  "type": "string"
                }
              ]
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "agentId",
            "state",
            "createdAt",
            "lastActivityAt"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "at": {
        "minimum": 0,
        "type": "integer"
      },
      "branches": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "branch": {
              "minLength": 1,
              "type": "string"
            },
            "repository": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "repository",
            "branch"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "confirmation": {
        "minLength": 1,
        "type": "string"
      },
      "folders": {
        "items": {
          "minLength": 1,
          "type": "string"
        },
        "type": "array"
      },
      "items": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "folder": {
              "minLength": 1,
              "type": "string"
            },
            "id": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "kind": {
              "anyOf": [
                {
                  "const": "bot",
                  "type": "string"
                },
                {
                  "const": "task",
                  "type": "string"
                },
                {
                  "const": "subtask",
                  "type": "string"
                },
                {
                  "const": "project",
                  "type": "string"
                },
                {
                  "const": "workspace",
                  "type": "string"
                }
              ]
            },
            "name": {
              "type": "string"
            },
            "running": {
              "type": "boolean"
            },
            "status": {
              "anyOf": [
                {
                  "const": "active",
                  "type": "string"
                },
                {
                  "const": "archived",
                  "type": "string"
                }
              ]
            }
          },
          "required": [
            "kind",
            "id",
            "name",
            "status",
            "running"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "keptFolders": {
        "items": {
          "minLength": 1,
          "type": "string"
        },
        "type": "array"
      },
      "target": {
        "additionalProperties": false,
        "properties": {
          "folder": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "anyOf": [
              {
                "const": "bot",
                "type": "string"
              },
              {
                "const": "task",
                "type": "string"
              },
              {
                "const": "subtask",
                "type": "string"
              },
              {
                "const": "project",
                "type": "string"
              },
              {
                "const": "workspace",
                "type": "string"
              }
            ]
          },
          "name": {
            "type": "string"
          },
          "running": {
            "type": "boolean"
          },
          "status": {
            "anyOf": [
              {
                "const": "active",
                "type": "string"
              },
              {
                "const": "archived",
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "kind",
          "id",
          "name",
          "status",
          "running"
        ],
        "type": "object"
      }
    },
    "required": [
      "target",
      "items",
      "agents",
      "folders",
      "branches",
      "keptFolders",
      "confirmation",
      "at"
    ],
    "type": "object"
  },
  "searchKeywords": [
    "preview delete",
    "dry run delete",
    "what would be deleted",
    "purge"
  ]
}
