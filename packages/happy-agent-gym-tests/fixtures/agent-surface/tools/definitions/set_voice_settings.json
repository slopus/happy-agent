              },
              {
                "type": "null"
              }
            ]
          },
          "providerId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "providerId",
          "modelId",
          "effort",
          "fastMode"
        ],
        "type": "object"
      },
      "defaultSystemPrompt": {
        "type": "string"
      },
