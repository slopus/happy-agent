{
  "capabilities": [
    "Publish Markdown documents and HTML pages with their images and other files, images, image series, videos, and documents as versioned artifacts, and list, read, update, and delete them."
  ],
  "defer": true,
  "description": "Change an artifact in one new version that keeps every earlier one, recorded as made by you, where you are working. title renames it, background changes the colour behind it, which almost every artifact leaves unset, display changes how the chat first shows it, and cover and summary change how it appears in the Feed.\n\nfiles copies files from your machine in, adding each path or replacing the file there — for example { \"fromPath\": \"out/chart.png\", \"path\": \"images/chart.png\" } to place an image you generated, or the files of an app you built and tried with the shell. A copy keeps its own name unless you give it a path. remove takes paths out. Write and edit text files with write_artifact_file and edit_artifact_file instead.\n\nA good artifact has a cover and a summary. The summary is a short post under the title: what this is and the key takeaway, in a few sentences of plain text, line breaks fine, no Markdown. The cover is a WebP, either 16:9 (1600×900) or square (1200×1200), showing the headline, key number, or main chart, readable at feed size; the Feed shows it full width and draws nothing over it. Add one to any report, analysis, or result people would want to see in the Feed; scratch and utility artifacts may go without. For a chart or diagram, render it first with what you have, such as a headless browser screenshot, rsvg-convert, or matplotlib, and save it as WebP. A short looping animated WebP is fine; keep it small, and convert a GIF to one first: ffmpeg -i in.gif -c:v libwebp -loop 0 -q:v 75 cover.webp. PNG and JPEG are accepted; GIF is accepted but discouraged; SVG is refused. To add or replace one, copy the image in and name it in the same call: files: [{ \"fromPath\": \"out/cover.webp\", \"path\": \"cover.webp\" }], cover: \"cover.webp\". A later version keeps the cover and summary until a change names new ones or removes them with null; removing or replacing the cover's file without naming another cover fails.\n\nEvery change makes a minor version, such as 1.3 after 1.2. When the artifact reaches a meaningful milestone, mark it with major, exactly one more than the latest major version: 2 makes this version 2.0, alone or together with the other changes. A major version needs at least one change since the last one.\n\nFor a live-URL artifact, url replaces its address while keeping the network captured at creation. Every update is reviewed in Auto. Do not supply files or remove: the fallback entry is generated, not editable. File artifacts and live artifacts cannot be converted into one another.",
  "durable": true,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "artifactId": {
        "maxLength": 32,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9]*$",
        "type": "string"
      },
      "background": {
        "anyOf": [
          {
            "pattern": "^#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Usually leave this out: the artifact then sits on the viewer's own surface and follows light and dark. Set a hex colour such as \"#ffffff\" only when the content needs one fixed canvas, such as a print-like document or a chart drawn for one palette. null removes it; leaving it out keeps it."
      },
      "cover": {
        "anyOf": [
          {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^(?!\\.\\.?(?:/|$))(?!.*/\\.\\.?(?:/|$))[^/\\\\\\x00-\\x1f\\x7f]{1,255}(?:/[^/\\\\\\x00-\\x1f\\x7f]{1,255})*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "The path of the artifact's cover image among its files, such as \"cover.webp\": a WebP, still or animated, showing the headline, key number, or main chart, readable at feed size. A cover is either 16:9 (1600×900) or square (1200×1200); other shapes are refused. PNG and JPEG work too; convert a GIF to animated WebP first, and SVG is refused. An image artifact's cover is its own picture and an image series' its first, unless you name another or pass null. null removes it; leaving it out keeps it, and its file must then stay in the artifact."
      },
      "display": {
        "anyOf": [
          {
            "const": "inline_compact",
            "type": "string"
          },
          {
            "const": "inline_expanded",
            "type": "string"
          },
          {
            "const": "side",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "How the chat first shows the artifact: \"inline_expanded\" starts open in the conversation, and \"inline_compact\" and \"side\" start collapsed to its title, which the reader can expand. Left out, html, image, image_series, and video artifacts start open and markdown starts collapsed. null removes it; leaving it out keeps it."
      },
      "files": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "fromPath": {
              "description": "A file on your machine to copy in, such as an image you generated, a PDF, or a file you built with the shell",
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "path": {
              "description": "Where the copy sits in the artifact, such as \"images/chart.png\", or \"index.md\" to make it a markdown artifact's entry. Defaults to the file's own name.",
              "maxLength": 1024,
              "minLength": 1,
              "pattern": "^(?!\\.\\.?(?:/|$))(?!.*/\\.\\.?(?:/|$))[^/\\\\\\x00-\\x1f\\x7f]{1,255}(?:/[^/\\\\\\x00-\\x1f\\x7f]{1,255})*$",
              "type": "string"
            }
          },
          "required": [
            "fromPath"
          ],
          "type": "object"
        },
        "maxItems": 256,
        "type": "array"
      },
      "major": {
        "description": "Make this version the next major version: exactly one more than the latest version's major, allowed once something changed since the last major version",
        "maximum": 9007199254740991,
        "minimum": 2,
        "type": "integer"
      },
      "remove": {
        "description": "Paths of files to take out of the artifact",
        "items": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^(?!\\.\\.?(?:/|$))(?!.*/\\.\\.?(?:/|$))[^/\\\\\\x00-\\x1f\\x7f]{1,255}(?:/[^/\\\\\\x00-\\x1f\\x7f]{1,255})*$",
          "type": "string"
        },
        "maxItems": 256,
        "type": "array"
      },
      "summary": {
        "anyOf": [
          {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "A short post shown under the title, like a tweet: what this is and the key takeaway, in a few sentences of plain text. Line breaks are fine; no Markdown. At most 5,000 characters. null removes it; leaving it out keeps it."
      },
      "title": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^(?=.*\\S)[^\\x00-\\x1f\\x7f]+$",
        "type": "string"
      },
      "url": {
        "description": "Replace a live artifact's http or https URL, keeping its original network. Not available for file artifacts.",
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "artifactId"
    ],
    "type": "object"
  },
