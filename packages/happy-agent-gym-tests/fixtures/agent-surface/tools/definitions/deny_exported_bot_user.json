{
  "autoReview": "never",
  "capabilities": [
    "Export bots to Telegram or other chat services and choose who may talk to them."
  ],
  "defer": true,
  "description": "Turn one person away from an exported bot, after they asked and the user said no. kind is how the bot is exported, \"telegram\" or \"bridge\"; botId is the exported bot; userId is the person's ID on that service. Use the values the access request named. The message they were waiting with is discarded, they are taken off the allowlist if they were on it, and nothing they send is answered or shown to anyone until someone approves them. They are not told. A guest they already were stays, so earlier messages keep their author.",
  "durable": true,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "botId": {
        "description": "The ID of the Happy bot that is exported, from list_bots.",
        "maxLength": 32,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9]*$",
        "type": "string"
      },
      "kind": {
        "description": "The kind of export, \"telegram\" or \"bridge\"",
        "maxLength": 32,
        "minLength": 1,
        "type": "string"
      },
      "userId": {
        "anyOf": [
          {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        ]
      }
    },
    "required": [
      "kind",
      "userId",
      "botId"
    ],
    "type": "object"
  },
  "name": "deny_exported_bot_user",
  "requiresAutoOrFullAccess": true,
  "returnType": {
    "additionalProperties": false,
    "properties": {
      "bot": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "botId": {
        "maxLength": 32,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9]*$",
        "type": "string"
      },
      "discarded": {
        "type": "boolean"
      },
      "kind": {
        "pattern": "^[a-z][a-z0-9_]{0,31}$",
        "type": "string"
      },
      "service": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "userId": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
        "type": "string"
      },
      "wasAllowed": {
        "type": "boolean"
      }
    },
    "required": [
      "botId",
      "bot",
      "kind",
      "service",
      "userId",
      "wasAllowed",
      "discarded"
    ],
    "type": "object"
  },
  "searchKeywords": [
    "deny exported bot access request",
    "block Telegram user",
    "decline access request"
  ]
}
