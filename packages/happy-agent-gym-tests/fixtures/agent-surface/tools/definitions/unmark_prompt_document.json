{
  "capabilities": [
    "List, mark, and unmark this installation's important documents."
  ],
  "defer": true,
  "description": "Stop listing a document Surface as important in every agent's instructions on this Happy Agent installation. The document itself is unchanged. Unmarking a document that is not marked changes nothing. The change applies from each agent's next turn. Only active admin bots may use it.",
  "durable": true,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "surfaceId": {
        "maxLength": 24,
        "minLength": 24,
        "pattern": "^[a-z][a-z0-9]{23}$",
        "type": "string"
      }
    },
    "required": [
      "surfaceId"
    ],
    "type": "object"
  },
  "name": "unmark_prompt_document",
  "requiresAutoOrFullAccess": true,
  "returnType": {
    "additionalProperties": false,
    "properties": {
      "changed": {
        "type": "boolean"
      },
      "documents": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "description": {
              "maxLength": 1024,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "displayName": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^(?=.*\\S)[^\\x00-\\x1f\\x7f]+$",
              "type": "string"
            },
            "link": {
              "minLength": 1,
              "type": "string"
            },
            "markedAt": {
              "minimum": 0,
              "type": "integer"
            },
            "markedByAgentId": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "name": {
              "anyOf": [
                {
                  "maxLength": 256,
                  "minLength": 1,
                  "pattern": "^(?=.*\\S)[^\\x00-\\x1f\\x7f]+$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "readable": {
              "type": "boolean"
            },
            "surfaceId": {
              "maxLength": 24,
              "minLength": 24,
              "pattern": "^[a-z][a-z0-9]{23}$",
              "type": "string"
            },
            "updatedAt": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "surfaceId",
            "name",
            "description",
            "markedAt",
            "markedByAgentId",
            "updatedAt",
            "displayName",
            "link",
            "readable"
          ],
          "type": "object"
        },
        "maxItems": 32,
        "type": "array"
      },
      "surfaceId": {
        "maxLength": 24,
        "minLength": 24,
        "pattern": "^[a-z][a-z0-9]{23}$",
        "type": "string"
      }
    },
    "required": [
      "surfaceId",
      "changed",
      "documents"
    ],
    "type": "object"
  },
  "searchKeywords": [
    "unmark important document",
    "remove document from system prompt",
    "prompt documents"
  ],
  "transactional": true
}
