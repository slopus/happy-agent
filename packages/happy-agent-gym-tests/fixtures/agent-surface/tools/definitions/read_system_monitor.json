{
  "autoReview": "never",
  "capabilities": [
    "Read live host CPU, GPU, memory, disk, and process usage."
  ],
  "defer": true,
  "description": "Read the machine running this daemon through one System Monitor Surface. Includes CPU, GPU, memory, mounted disks, disk activity, recent history, and top processes by CPU and resident memory. Several System Monitors show the same host. Unavailable measurements are null. Process names exclude command-line arguments and environments. Reading never changes membership.",
  "durable": false,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "surfaceId": {
        "maxLength": 24,
        "minLength": 24,
        "pattern": "^[a-z][a-z0-9]{23}$",
        "type": "string"
      }
    },
    "required": [
      "surfaceId"
    ],
    "type": "object"
  },
  "name": "read_system_monitor",
  "returnType": {
    "properties": {
      "cpu": {
        "properties": {
          "loadAverage": {
            "anyOf": [
              {
                "additionalItems": false,
                "items": [
                  {
                    "minimum": 0,
                    "type": "number"
                  },
                  {
                    "minimum": 0,
                    "type": "number"
                  },
                  {
                    "minimum": 0,
                    "type": "number"
                  }
                ],
                "maxItems": 3,
                "minItems": 3,
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          },
          "logicalCores": {
            "minimum": 0,
            "type": "integer"
          },
          "model": {
            "type": "string"
          },
          "perCoreUsagePercent": {
            "anyOf": [
              {
                "items": {
                  "maximum": 100,
                  "minimum": 0,
                  "type": "number"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          },
          "speedMhz": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "temperatureCelsius": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "usagePercent": {
            "anyOf": [
              {
                "maximum": 100,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "model",
          "logicalCores",
          "usagePercent",
          "perCoreUsagePercent",
          "loadAverage",
          "speedMhz",
          "temperatureCelsius"
        ],
        "type": "object"
      },
      "diskIo": {
        "anyOf": [
          {
            "properties": {
              "readBytesPerSecond": {
                "minimum": 0,
                "type": "number"
              },
              "writeBytesPerSecond": {
                "minimum": 0,
                "type": "number"
              }
            },
            "required": [
              "readBytesPerSecond",
              "writeBytesPerSecond"
            ],
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
      },
      "disks": {
        "items": {
          "properties": {
            "availableBytes": {
              "minimum": 0,
              "type": "number"
            },
            "device": {
              "type": "string"
            },
            "fileSystem": {
              "anyOf": [
                {
                  "type": "string"
