                {
                  "const": "apple",
                  "type": "string"
                },
                {
                  "const": "intel",
                  "type": "string"
                },
                {
                  "const": "other",
                  "type": "string"
                }
              ]
            }
          },
          "required": [
            "name",
            "vendor",
            "usagePercent",
            "memoryTotalBytes",
            "memoryUsedBytes",
            "temperatureCelsius",
            "powerWatts"
