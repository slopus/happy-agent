          "type": "object"
        },
        "type": "array"
      },
      "history": {
        "items": {
          "properties": {
            "cpuPercent": {
              "anyOf": [
                {
                  "maximum": 100,
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
