{
  "autoReview": "never",
  "capabilities": [
    "Find, inspect, and clean up stale bots, tasks, subtasks, projects, workspaces, and folders on this installation."
  ],
  "defer": true,
  "description": "List folders under this installation's Happy bot, task, workspace, and cloned-project folders, and the default runner's, that no bot, task, project, workspace, or agent names any more: leftovers of deleted or failed work. Surface folders are not checked. Check a folder with find_folder_owners before removing it; removing one is an ordinary, reviewed shell action. Only active admin bots may use it.",
  "durable": false,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {},
    "type": "object"
  },
  "name": "find_orphan_folders",
  "reloadable": true,
  "returnType": {
    "additionalProperties": false,
    "properties": {
      "orphans": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "folder": {
              "minLength": 1,
              "type": "string"
            },
            "root": {
              "anyOf": [
                {
                  "const": "bots",
                  "type": "string"
                },
                {
                  "const": "tasks",
                  "type": "string"
                },
                {
                  "const": "workspaces",
                  "type": "string"
                },
                {
                  "const": "projects",
                  "type": "string"
                }
              ]
            },
            "runnerId": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "root",
            "folder"
          ],
          "type": "object"
        },
        "maxItems": 500,
        "type": "array"
      },
      "roots": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "error": {
              "type": "string"
            },
            "folder": {
              "minLength": 1,
              "type": "string"
            },
            "root": {
              "anyOf": [
                {
                  "const": "bots",
                  "type": "string"
                },
                {
                  "const": "tasks",
                  "type": "string"
                },
                {
                  "const": "workspaces",
                  "type": "string"
                },
                {
                  "const": "projects",
                  "type": "string"
                }
              ]
            },
            "runnerId": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "root",
            "folder"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "truncated": {
        "type": "boolean"
      }
    },
    "required": [
      "orphans",
      "roots",
      "truncated"
    ],
    "type": "object"
  },
  "searchKeywords": [
    "orphan folders",
    "leftover folders",
    "unused folders",
    "disk cleanup"
  ]
}
