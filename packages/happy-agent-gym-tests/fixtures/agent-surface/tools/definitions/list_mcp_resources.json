{
  "autoReview": "never",
  "capabilities": [
    "Discover and use configured MCP servers, resources, prompts, and tools."
  ],
  "defer": true,
  "description": "Lists resources exposed by an MCP server. Available servers: Echo, Remote Notes. Use the returned next cursor to continue pagination.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "cursor": {
        "maxLength": 32,
        "minLength": 1,
        "type": "string"
      },
      "server": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      }
    },
    "required": [
      "server"
    ],
    "type": "object"
  },
  "name": "list_mcp_resources",
  "reloadable": true,
  "requiresAutoOrFullAccess": true,
  "returnType": {
    "additionalProperties": false,
    "properties": {
      "nextCursor": {
        "maxLength": 32,
        "minLength": 1,
        "type": "string"
      },
      "resources": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "_meta": {
              "maxProperties": 2048,
              "patternProperties": {
                "^(.*)$": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "maxLength": 1000000,
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    {
                      "maxItems": 2048,
                      "type": "array"
                    },
                    {
                      "maxProperties": 2048,
                      "type": "object"
                    }
                  ]
                }
              },
              "type": "object"
            },
            "annotations": {
              "additionalProperties": false,
              "properties": {
                "audience": {
                  "items": {
                    "anyOf": [
                      {
                        "const": "user",
                        "type": "string"
                      },
                      {
                        "const": "assistant",
                        "type": "string"
                      }
                    ]
                  },
                  "maxItems": 2,
                  "type": "array"
                },
                "lastModified": {
                  "maxLength": 128,
                  "type": "string"
                },
                "priority": {
                  "type": "number"
                }
              },
              "type": "object"
            },
            "description": {
              "maxLength": 16384,
              "type": "string"
            },
            "mimeType": {
              "maxLength": 128,
              "type": "string"
            },
            "name": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "title": {
              "maxLength": 16384,
              "type": "string"
            },
            "uri": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "name",
            "uri"
          ],
          "type": "object"
        },
        "maxItems": 100,
        "type": "array"
      }
    },
    "required": [
      "resources"
    ],
    "type": "object"
  },
  "searchKeywords": [
    "list MCP resources",
    "remote resource catalog"
  ]
}
