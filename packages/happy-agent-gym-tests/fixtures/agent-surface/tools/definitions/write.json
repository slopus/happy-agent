{
  "autoPermissionInstructions": "For write, request reviewed Full access for this file change with sandbox_permissions: \"require_escalated\" and explain why in description. Protected and outside-workspace paths are also reviewed automatically without the flag. Approval elevates only this call; Read only and Workspace write never elevate.",
  "capabilities": [
    "Read and modify files, run shell commands, inspect images, and manage background processes."
  ],
  "defer": false,
  "description": "Create or overwrite a file.\n\n- Writing to an existing path replaces the file.\n- Parent directories are created for you.\n- Prefer search_replace for changing part of a file; this tool is for new files and complete rewrites.",
  "durable": false,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "content": {
        "description": "The full file content to write.",
        "type": "string"
      },
      "description": {
        "description": "Concise user-facing reason why sandbox escalation is needed. Use only with require_escalated.",
        "type": "string"
      },
      "file_path": {
        "description": "The absolute path to the file to write.",
        "type": "string"
      },
      "sandbox_permissions": {
        "anyOf": [
          {
            "const": "use_default",
            "type": "string"
          },
          {
            "const": "require_escalated",
            "type": "string"
          }
        ],
        "description": "Request reviewed Full access for this write in Auto mode. Protected and outside-workspace paths are also reviewed automatically when omitted."
      }
    },
    "required": [
      "file_path",
      "content"
    ],
    "type": "object"
  },
  "name": "write",
  "returnType": {
    "additionalProperties": false,
    "properties": {
      "characters": {
        "type": "integer"
      },
      "created": {
        "type": "boolean"
      },
      "path": {
        "type": "string"
      },
      "presentation": {
        "additionalProperties": false,
        "properties": {
          "files": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "added": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "deleted": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "hunks": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "lines": {
                        "items": {
                          "additionalProperties": false,
                          "properties": {
                            "kind": {
                              "anyOf": [
                                {
                                  "const": "context",
                                  "type": "string"
                                },
                                {
                                  "const": "add",
                                  "type": "string"
                                },
                                {
                                  "const": "delete",
                                  "type": "string"
                                }
                              ]
                            },
                            "text": {
                              "maxLength": 4000,
                              "type": "string"
                            }
                          },
                          "required": [
                            "kind",
                            "text"
                          ],
                          "type": "object"
                        },
                        "maxItems": 500,
                        "type": "array"
                      },
                      "newStart": {
                        "maximum": 9007199254740991,
                        "minimum": 0,
                        "type": "integer"
                      },
                      "oldStart": {
                        "maximum": 9007199254740991,
                        "minimum": 0,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "oldStart",
                      "newStart",
                      "lines"
                    ],
                    "type": "object"
                  },
                  "maxItems": 500,
                  "type": "array"
                },
                "kind": {
                  "anyOf": [
                    {
                      "const": "add",
                      "type": "string"
                    },
                    {
                      "const": "delete",
                      "type": "string"
                    },
                    {
                      "const": "update",
                      "type": "string"
                    }
                  ]
                },
                "language": {
                  "maxLength": 256,
                  "type": "string"
                },
                "omittedLines": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "path": {
                  "maxLength": 4000,
                  "type": "string"
                }
              },
              "required": [
                "path",
                "kind",
                "added",
                "deleted",
                "hunks"
              ],
              "type": "object"
            },
            "maxItems": 20,
            "type": "array"
          },
          "omittedFiles": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "type": {
            "const": "file_diff",
            "type": "string"
          }
        },
        "required": [
          "type",
          "files"
        ],
        "type": "object"
      }
    },
    "required": [
      "path",
      "created",
      "characters",
      "presentation"
    ],
    "type": "object"
  }
}
