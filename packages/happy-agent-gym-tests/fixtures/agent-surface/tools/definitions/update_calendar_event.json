                "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(?:/[A-Za-z0-9_+-]+)*$",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "start",
              "end",
              "timeZone"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "endDate": {
                "pattern": "^(?:19[7-9][0-9]|[2-9][0-9]{3})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$",
                "type": "string"
