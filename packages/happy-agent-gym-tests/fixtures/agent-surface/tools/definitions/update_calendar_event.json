{
  "capabilities": [
    "Change, move, or restore a calendar event, including its recurrence."
  ],
  "defer": true,
  "description": "Edit one calendar event with the version you read. Supply only the fields to change; timing and recurrence replace the whole value. Edits change the whole series. Set notes, location, or recurrence to null to clear them and title to \"\" to empty it. status 'active' undeletes a deleted event and 'deleted' deletes it. To restore an earlier state, read it with list_calendar_event_versions and pass its title, notes, location, timing, recurrence, and status here with the current version; history keeps every state. Timed timing is {kind:'timed', start, end, timeZone}: start and end are local wall-clock date-times such as 2026-10-20T09:00 in timeZone, an IANA name such as Europe/Berlin (never a bare offset). Use the zone the person means, usually their own. An optional trailing offset must match the zone at that time and picks one instant of a repeated hour; without it, a time skipped by a daylight-saving jump moves forward and a repeated time takes the earlier instant. All-day timing is {kind:'allDay', startDate, endDate} with endDate exclusive: a one-day event on 2026-10-20 has endDate 2026-10-21. Events last at most 366 days. Recurrence is null or {frequency: daily|weekly|monthly|yearly, interval (default 1), weekdays (weekly only: monday…sunday, or null for the start's weekday), until (inclusive YYYY-MM-DD) or count (total occurrences)}; at most one of until and count. The event's own timing is occurrence 0. Monthly and yearly skip months or years without the start's day (31st, 29 February). Times stay at the same wall-clock time across daylight-saving changes. There are no per-occurrence exceptions: every edit changes the whole series. Conflicts require a fresh read.",
  "durable": true,
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "eventId": {
        "maxLength": 32,
        "minLength": 2,
        "pattern": "^[a-z][a-z0-9]*$",
        "type": "string"
      },
      "location": {
        "anyOf": [
          {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^(?=[\\s\\S]*\\S)[^\\x00-\\x1f\\x7f]+$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "notes": {
        "anyOf": [
          {
            "maxLength": 10000,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x08\\x0b-\\x1f\\x7f]+$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "recurrence": {
        "anyOf": [
          {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "count": {
                    "anyOf": [
                      {
                        "maximum": 10000,
                        "minimum": 1,
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "frequency": {
                    "const": "weekly",
                    "type": "string"
                  },
                  "interval": {
                    "maximum": 1000,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "until": {
                    "anyOf": [
                      {
                        "pattern": "^(?:19[7-9][0-9]|[2-9][0-9]{3})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "weekdays": {
                    "anyOf": [
                      {
                        "items": {
                          "anyOf": [
                            {
                              "const": "monday",
                              "type": "string"
                            },
                            {
                              "const": "tuesday",
                              "type": "string"
                            },
                            {
                              "const": "wednesday",
                              "type": "string"
                            },
                            {
