                "type": "string"
              }
            },
            "required": [
              "kind",
              "startDate",
              "endDate"
            ],
            "type": "object"
          }
        ]
      },
      "title": {
        "maxLength": 1024,
        "pattern": "^[^\\x00-\\x1f\\x7f]*$",
