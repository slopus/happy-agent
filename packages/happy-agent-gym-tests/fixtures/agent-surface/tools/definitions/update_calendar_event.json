                          ]
                        },
                        "maxItems": 7,
                        "minItems": 1,
                        "type": "array",
                        "uniqueItems": true
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "frequency"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "count": {
                    "anyOf": [
                      {
                        "maximum": 10000,
                        "minimum": 1,
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "frequency": {
                    "anyOf": [
                      {
                        "const": "daily",
                        "type": "string"
                      },
                      {
                        "const": "monthly",
                        "type": "string"
                      },
                      {
                        "const": "yearly",
                        "type": "string"
                      }
                    ]
                  },
                  "interval": {
                    "maximum": 1000,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "until": {
                    "anyOf": [
                      {
                        "pattern": "^(?:19[7-9][0-9]|[2-9][0-9]{3})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "frequency"
                ],
                "type": "object"
              }
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "status": {
        "anyOf": [
          {
            "const": "active",
            "type": "string"
          },
          {
            "const": "deleted",
            "type": "string"
