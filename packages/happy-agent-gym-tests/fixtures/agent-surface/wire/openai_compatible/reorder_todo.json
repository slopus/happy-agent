{"type":"function","function":{"name":"reorder_todo","description":"Move an active todo after another active todo in the same Surface, or first with afterId null. Completed and deleted todos cannot be reordered.","parameters":{"additionalProperties":false,"type":"object","required":["surfaceId","todoId","version","afterId"],"properties":{"surfaceId":{"minLength":24,"maxLength":24,"pattern":"^[a-z][a-z0-9]{23}$","type":"string"},"todoId":{"minLength":2,"maxLength":32,"pattern":"^[a-z][a-z0-9]*$","type":"string"},"version":{"type":"string"},"afterId":{"anyOf":[{"minLength":2,"maxLength":32,"pattern":"^[a-z][a-z0-9]*$","type":"string"},{"type":"null"}]}}}}}