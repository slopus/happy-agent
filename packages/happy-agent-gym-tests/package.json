{
    "name": "@slopus/happy-agent-gym-tests",
    "private": true,
    "type": "module",
    "scripts": {
        "check": "tsc --noEmit",
        "test:gym": "pnpm dlx bun@1.4.4 runGym.ts",
        "test:gym:node": "pnpm dlx bun@1.4.4 runGym.ts --lane=node",
        "test:gym:api": "pnpm dlx bun@1.4.4 scripts/runHappyApiSuite.ts",
        "vitest:bun": "pnpm dlx bun@1.4.4 --bun node_modules/vitest/vitest.mjs",
        "export:agent-surface": "HAPPY_AGENT_SURFACE_UPDATE=1 pnpm vitest:bun run tests/agent_surface_fixtures_match_what_models_receive.test.ts"
    },
    "devDependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "@sinclair/typebox": "^0.34.49",
        "@slopus/happy-agent-client": "0.0.159",
        "@slopus/happy-agent-gym": "workspace:*",
        "@slopus/happy-providers": "0.0.57",
        "@steve.kite/stdlib": "0.0.12",
        "@types/node": "^24.0.10",
        "@types/ws": "8.18.1",
        "fflate": "0.8.2",
        "tweetnacl": "0.14.5",
        "typescript": "^5.8.3",
        "vitest": "^3.2.4",
        "ws": "^8.21.1",
        "yjs": "13.6.31"
    }
}
