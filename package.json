{
    "name": "@slopus/happy-agent-workspace",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm --filter @slopus/happy-providers build && pnpm --filter @slopus/happy-agent-modules build && pnpm --filter @slopus/happy-agent-compute build && pnpm --filter @slopus/happy-agent build && pnpm --filter happy-plugins build && pnpm --filter happy-worklets build && pnpm --filter @slopus/happy-terminal build",
        "build:bun": "pnpm build && pnpm --filter @slopus/happy-agent build:bun",
        "build:bun:all": "pnpm build && pnpm --filter @slopus/happy-agent build:bun:all",
        "build:gym": "pnpm --filter @slopus/happy-terminal-gym run build:image",
        "check": "pnpm --filter @slopus/happy-providers build && pnpm --filter @slopus/happy-agent-modules build && pnpm --filter @slopus/happy-agent-compute build && pnpm --filter @slopus/happy-agent build && pnpm --filter happy-plugins build && pnpm --filter happy-worklets build && pnpm run check:root && pnpm --recursive --filter './packages/**' run check",
        "check:root": "tsc --noEmit -p tsconfig.json",
        "dev": "pnpm build && node scripts/seedDevConfig.mjs && HAPPY_HOME_DIR=\"$PWD/.happy-terminal-dev/.happy\" pnpm start daemon reload && HAPPY_HOME_DIR=\"$PWD/.happy-terminal-dev/.happy\" pnpm start",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "link:global": "pnpm build && cd packages/happy-terminal && pnpm link --global && happy-terminal daemon reload",
        "lint": "oxlint .",
        "observability:down": "node scripts/observability.mjs down",
        "observability:restart": "node scripts/observability.mjs restart",
        "observability:status": "node scripts/observability.mjs status",
        "observability:up": "node scripts/observability.mjs up",
        "release": "TMPDIR=\"$PWD/.local\" tsx scripts/release.ts",
        "release:beta": "pnpm release beta",
        "release:minor": "pnpm release minor",
        "release:patch": "pnpm release patch",
        "release:happy-agent-base:patch": "pnpm release happy-agent-base patch",
        "release:happy-agent-client:patch": "pnpm release happy-agent-client patch",
        "release:happy-agent-compute:patch": "pnpm release happy-agent-compute patch",
        "release:happy-providers:patch": "pnpm release happy-providers patch",
        "release:happy-plugins:patch": "pnpm release happy-plugins patch",
        "start": "node packages/happy-terminal/dist/main.js",
        "test": "pnpm --filter @slopus/happy-agent-modules build && pnpm --filter @slopus/happy-agent-compute build && pnpm run test:scripts && pnpm --recursive --filter './packages/**' run test",
        "test:release": "pnpm --filter @slopus/happy-agent-modules build && pnpm --filter @slopus/happy-agent-compute build && pnpm run test:scripts && pnpm --recursive --workspace-concurrency=1 --filter './packages/**' --filter '!happy-plugins' --filter '!@slopus/happy-providers' run test",
        "test:gym": "pnpm --filter @slopus/happy-terminal-gym-tests test:gym",
        "test:gym:api": "pnpm --filter @slopus/happy-terminal-gym-tests test:gym:api",
        "test:gym:fast": "pnpm --filter @slopus/happy-terminal-gym-tests test:gym:fast",
        "test:gym:full": "pnpm --filter @slopus/happy-terminal-gym-tests test:gym:full",
        "test:gym:heavy": "pnpm --filter @slopus/happy-terminal-gym-tests test:gym:heavy",
        "test:gym:live:grok": "pnpm --filter @slopus/happy-terminal-gym-tests test:gym:live:grok",
        "test:gym:docker": "pnpm --filter @slopus/happy-terminal-gym-tests test:gym:docker",
        "test:gym:slow": "pnpm --filter @slopus/happy-terminal-gym-tests test:gym:slow",
        "test:live": "pnpm --filter @slopus/happy-terminal test:live",
        "test:scripts": "TMPDIR=\"$PWD/.local\" tsx --test scripts/release/*.test.ts",
        "test:watch": "pnpm --filter @slopus/happy-terminal test:watch",
        "unlink:global": "pnpm remove --global @slopus/happy-terminal"
    },
    "devDependencies": {
        "@types/node": "^24.0.10",
        "drizzle-orm": "^0.45.2",
        "oxfmt": "^0.57.0",
        "oxlint": "^1.72.0",
        "tsx": "^4.23.0",
        "typescript": "^5.8.3"
    },
    "packageManager": "pnpm@10.28.1",
    "pnpm": {
        "overrides": {
            "@steve.kite/stdlib": "0.0.12"
        },
        "supportedArchitectures": {
            "cpu": [
                "arm64",
                "x64"
            ],
            "os": [
                "darwin",
                "linux"
            ]
        },
        "onlyBuiltDependencies": [
            "@ffmpeg-installer/darwin-arm64",
            "@ffmpeg-installer/darwin-x64",
            "@ffmpeg-installer/linux-arm",
            "@ffmpeg-installer/linux-arm64",
            "@ffmpeg-installer/linux-ia32",
            "@ffmpeg-installer/linux-x64",
            "@ffmpeg-installer/win32-ia32",
            "@ffmpeg-installer/win32-x64",
            "@ffprobe-installer/darwin-arm64",
            "@ffprobe-installer/darwin-x64",
            "@ffprobe-installer/linux-arm",
            "@ffprobe-installer/linux-arm64",
            "@ffprobe-installer/linux-ia32",
            "@ffprobe-installer/linux-x64",
            "@ffprobe-installer/win32-ia32",
            "@ffprobe-installer/win32-x64"
        ]
    }
}
