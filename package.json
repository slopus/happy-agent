{
    "name": "@slopus/happy-agent-workspace",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "pnpm --filter @slopus/happy-agent-supervisor build && pnpm --filter @slopus/happy-agent-client build && pnpm --filter @slopus/happy-providers build && pnpm --filter @slopus/happy-agent-compute build && pnpm --filter @slopus/happy-agent-modules build && pnpm --filter @slopus/happy-agent build && pnpm --filter happy-plugins build && pnpm --filter happy-worklets build",
        "build:bun": "pnpm build && pnpm --filter @slopus/happy-agent build:bun",
        "build:bun:all": "pnpm build && pnpm --filter @slopus/happy-agent build:bun:all",
        "check": "pnpm --filter @slopus/happy-providers build && pnpm --filter @slopus/happy-agent-modules build && pnpm --filter @slopus/happy-agent-compute build && pnpm --filter @slopus/happy-agent build && pnpm --filter happy-plugins build && pnpm --filter happy-worklets build && pnpm run check:root && pnpm --recursive --filter './packages/**' run check",
        "check:root": "tsc --noEmit -p tsconfig.json",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint .",
        "observability:down": "node scripts/observability.mjs down",
        "observability:restart": "node scripts/observability.mjs restart",
        "observability:status": "node scripts/observability.mjs status",
        "observability:up": "node scripts/observability.mjs up",
        "prepare": "husky",
        "release": "TMPDIR=\"$PWD/.local\" tsx scripts/release.ts",
        "release:happy-agent-base:patch": "pnpm release happy-agent-base patch",
        "release:happy-agent-client:patch": "pnpm release happy-agent-client patch",
        "release:happy-agent-compute:patch": "pnpm release happy-agent-compute patch",
        "release:happy-providers:patch": "pnpm release happy-providers patch",
        "release:happy-plugins:patch": "pnpm release happy-plugins patch",
        "test": "pnpm --filter @slopus/happy-agent-modules build && pnpm --filter @slopus/happy-agent-compute build && pnpm run test:scripts && pnpm --recursive --filter './packages/**' run test",
        "test:gym": "pnpm --filter @slopus/happy-agent-gym-tests test:gym",
        "test:gym:api": "pnpm --filter @slopus/happy-agent-gym-tests test:gym:api",
        "test:scripts": "TMPDIR=\"$PWD/.local\" tsx --test scripts/release/*.test.ts"
    },
    "devDependencies": {
        "@types/node": "^24.0.10",
        "drizzle-orm": "^0.45.2",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "oxfmt": "^0.57.0",
        "oxlint": "^1.72.0",
        "tsx": "^4.23.0",
        "typescript": "^5.8.3"
    },
    "lint-staged": {
        "*.{cjs,cts,js,json,jsonc,jsx,md,mjs,mts,toml,ts,tsx,yaml,yml}": "oxfmt --write --no-error-on-unmatched-pattern"
    },
    "packageManager": "pnpm@10.28.1",
    "pnpm": {
        "overrides": {
            "@slopus/happy-providers": "0.0.38",
            "@steve.kite/stdlib": "0.0.12"
        },
        "supportedArchitectures": {
            "cpu": [
                "arm64",
                "x64"
            ],
            "os": [
                "darwin",
                "linux",
                "win32"
            ]
        },
        "onlyBuiltDependencies": [
            "@ffmpeg-installer/darwin-arm64",
            "@ffmpeg-installer/darwin-x64",
            "@ffmpeg-installer/linux-arm",
            "@ffmpeg-installer/linux-arm64",
            "@ffmpeg-installer/linux-ia32",
            "@ffmpeg-installer/linux-x64",
            "@ffmpeg-installer/win32-ia32",
            "@ffmpeg-installer/win32-x64",
            "@ffprobe-installer/darwin-arm64",
            "@ffprobe-installer/darwin-x64",
            "@ffprobe-installer/linux-arm",
            "@ffprobe-installer/linux-arm64",
            "@ffprobe-installer/linux-ia32",
            "@ffprobe-installer/linux-x64",
            "@ffprobe-installer/win32-ia32",
            "@ffprobe-installer/win32-x64",
            "@parcel/watcher"
        ],
        "patchedDependencies": {
            "libsql@0.5.29": "patches/libsql@0.5.29.patch",
            "@libsql/client@0.18.0": "patches/@libsql__client@0.18.0.patch",
            "@parcel/watcher@2.6.0": "patches/@parcel__watcher@2.6.0.patch"
        },
        "packageExtensions": {
            "@parcel/watcher@2.6.0": {
                "dependencies": {
                    "node-gyp": "12.4.0"
                }
            }
        }
    }
}
