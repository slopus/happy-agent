{
  "genui": 1,
  "fallback": "Add a Stripe API key so agents can call api.stripe.com through the egress proxy.",
  "root": {
    "type": "card",
    "title": "Stripe API key",
    "icon": "lock",
    "children": [
      {
        "type": "text",
        "text": "Billing agents call `api.stripe.com`. Add a restricted key and the proxy sends it for them; no agent sees the key."
      }
    ],
    "actions": [
      {
        "type": "button",
        "id": "add-stripe",
        "label": "Add Stripe key",
        "icon": "lock",
        "action": {
          "type": "cluster_secret",
          "secret": {
            "type": "endpoint",
            "name": "Stripe API",
            "description": "Restricted key for billing agents",
            "public": {
              "targets": [
                {
                  "host": "api.stripe.com",
                  "pathPrefixes": [
                    "/v1"
                  ],
                  "methods": [
                    "GET",
                    "POST"
                  ]
                }
              ],
              "algorithm": {
                "kind": "headers",
                "headers": [
                  {
                    "name": "Authorization",
                    "prefix": "Bearer "
                  }
                ]
              }
            },
            "owner": "team",
            "uses": [
              "egress"
            ]
          }
        }
      }
    ]
  }
}
