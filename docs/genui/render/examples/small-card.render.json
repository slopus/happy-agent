    "revenue.line": { "type": "box", "props": { "direction": "row", "gap": "inline", "align": "baseline", "wrap": true }, "children": ["revenue.value", "revenue.trend", "revenue.delta", "revenue.deltaLabel"] },
    "revenue.value": { "type": "text", "props": { "role": "value", "spans": [{ "text": "$1.24M" }] } },
